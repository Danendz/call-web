# Copy to .env for `npm run dev`. On Railway, set these as service variables instead.
# Everything is optional: without a key, that feature is just off.

# Groq: the free models chat is translated with first
GROQ_API_KEY=

# DeepSeek (or any OpenAI-compatible API): translates chat once Groq's free quota is used up
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# coturn (turn.danendz.com). Without TURN_HOST calls only connect on the same network
TURN_HOST=
# Must equal coturn's static-auth-secret
TURN_SECRET=
TURN_PORT=3478
TURNS_PORT=5349

# Postgres for accounts and friends. Without it only room links work.
# Locally: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:17
DATABASE_URL=

# PORT=8080
# STATIC_DIR=dist/web
