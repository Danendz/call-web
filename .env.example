# Copy to .env for `npm run dev`. On Railway, set these as service variables instead.
# Everything is optional: without a key, that feature is just off.

# Groq: Whisper transcription for browsers that can't recognize speech themselves (Quark, Chrome in
# China), and the free models chat is translated with first
GROQ_API_KEY=

# DeepSeek (or any OpenAI-compatible API): translates chat once Groq's free quota is used up
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# coturn (turn.danendz.com). Without TURN_HOST calls only connect on the same network
TURN_HOST=
# Must equal coturn's static-auth-secret
TURN_SECRET=
TURN_PORT=3478
TURNS_PORT=5349

# PORT=8080
# STATIC_DIR=dist/web
