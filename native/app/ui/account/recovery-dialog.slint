import { Theme } from "../theme.slint";
import { Icons } from "../components/icons.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { CopyLink } from "../components/copy-link.slint";
import { Dialog } from "../components/dialog.slint";

// A new recovery code, shown once until it's saved: closed() once it is.
export component RecoveryDialog inherits Dialog {
    in property <string> code;
    // Answered only by saving it
    required: true;

    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 60px;
            height: 60px;
            border-radius: self.width / 2;
            background: Theme.surface-3;
            Image {
                source: Icons.shield-check;
                colorize: Theme.muted;
                width: 26px;
                height: 26px;
            }
        }
    }
    Text {
        text: @tr("Save your recovery code");
        color: Theme.text;
        font-size: 20px;
        font-weight: 650;
        horizontal-alignment: center;
    }
    Text {
        text: @tr("It's the only way back in if you forget your password, and it's shown only now.");
        color: Theme.muted;
        wrap: word-wrap;
        horizontal-alignment: center;
    }
    CopyLink {
        url: root.code;
        label: @tr("Recovery code");
    }
    Button {
        text: @tr("I saved it");
        kind: ButtonKind.primary;
        clicked => { root.dismiss(); }
    }
}
