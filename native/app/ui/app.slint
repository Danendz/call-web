// The window only picks the screen for the phase, like web/src/App.tsx. State comes from the engine via the bridge.

import { Theme } from "theme.slint";
import { Icons } from "components/icons.slint";
import { Button, ButtonKind } from "components/button.slint";
import { Centered } from "components/centered.slint";
import { StartScreen, ModelState } from "start/start.slint";
import { SettingsSheet } from "settings/settings.slint";
import { SetupScreen } from "setup/setup.slint";
import { DeviceItem } from "setup/device-row.slint";
import { CallScreen, CallLink, StatsView, ChatRow } from "call/call.slint";
import { SubtitleLine } from "call/subtitles.slint";
import { ModelPrompt } from "components/model-prompt.slint";

export { DeviceItem, CallLink, StatsView, ChatRow, ModelState, SubtitleLine }

export enum AppPhase { start, setup, starting, waiting, in-call, full, ended }
export enum CamAccess { pending, granted, denied, missing }

export component AppWindow inherits Window {
    in property <AppPhase> phase: start;
    in property <string> lang: "en";
    in property <string> room-url;
    in property <bool> reconnecting;
    in property <CallLink> link;
    in property <string> elapsed;
    in property <bool> mic-on: true;
    in property <[DeviceItem]> mics;
    in property <string> mic-id;
    in property <string> mic-label;
    in property <[DeviceItem]> speakers;
    in property <string> speaker-id;
    in property <string> speaker-label;
    // We muted the other person; they muted us
    in property <bool> speaker-off;
    in property <bool> peer-speaker-off;
    in property <float> mic-level;
    in property <bool> cam-on: true;
    in property <CamAccess> cam-access;
    in property <[DeviceItem]> cams;
    in property <string> cam-id;
    in property <string> cam-label;
    in property <bool> portrait;
    in property <image> self-video;
    in property <image> peer-video;
    in property <image> screen-video;
    in property <bool> remote-screen;
    in property <bool> sharing;
    in property <[DeviceItem]> screen-sources;
    in property <string> corner-self: "br";
    in property <string> corner-peer: "tr";
    in property <string> corner-screen: "tl";
    in property <int> peer-frame-rotation;
    // Clockwise degrees that turn our camera's frames upright: a phone's sensor lies sideways
    in property <int> self-frame-rotation;
    // Android's picture-in-picture window is up
    in property <bool> pip;
    in property <bool> peer-cam-on: true;
    in property <StatsView> stats;
    in property <bool> force-relay;
    // "Connection stats" in Settings, remembered between launches
    in property <bool> show-stats;
    callback set-show-stats(bool);
    // "Noise suppression" in Settings, remembered between launches
    in property <bool> noise-suppression;
    callback set-noise-suppression(bool);
    property <bool> settings-open;
    in property <[ChatRow]> chat;
    in property <int> others-count;
    in property <[SubtitleLine]> subtitles;
    // "Live subtitles" in Settings, remembered between launches
    in property <bool> subtitles-on;
    callback set-subtitles-on(bool);
    in property <bool> transcribe-on;
    in property <int> speech-notice;
    in property <string> speech-paused-until;
    in property <bool> peer-screenshot;
    in property <string> saved-shot;
    // Counts screenshots that couldn't be saved, so each one shows its toast
    in property <int> shot-failures;
    in property <string> version;
    // The on-device speech model, for settings and the first launch's question
    in property <ModelState> model-state;
    in property <int> model-progress;
    in property <string> model-size;
    in property <bool> on-device;
    in-out property <bool> speech-prompt;
    callback download-model();
    callback cancel-model-download();
    callback delete-model();
    callback set-on-device(bool);
    callback dismiss-speech-prompt();
    // The translation model live subtitles need in this language, and whether its offer was put off
    in property <ModelState> translation-state;
    in property <int> translation-progress;
    in property <string> translation-size;
    in-out property <bool> translation-dismissed;
    callback download-translation();
    callback delete-translation();
    callback dismiss-translation-prompt();
    // Set once an update has downloaded; it installs on quit, or now from the start screen
    in property <string> update-version;
    // 0–100 while an update downloads, else -1
    in property <int> update-progress: -1;
    // Set on a phone: a touch screen with an on-screen keyboard
    in property <bool> touch;
    // Where the call's sound plays on a phone ("speaker", "earpiece", "bluetooth"), and which of them there are
    in property <[string]> outputs;
    in property <string> output;
    callback pick-output(string);
    in property <string> background-guide;
    callback open-background-settings();
    callback dismiss-background-guide();
    // The call notification's text, in the app's language: title while waiting, title in a call, text, mute, unmute,
    // hang up
    out property <[string]> call-notice: [
        @tr("Waiting for the other person to join…"),
        @tr("In a call"),
        @tr("Tap to return to the call"),
        @tr("Mute"),
        @tr("Unmute"),
        @tr("Hang up"),
    ];

    // The web's deviceStatus: why a device can't be used
    property <string> cam-status: cam-access == CamAccess.pending ? @tr("Camera: Asking for permission…")
        : cam-access == CamAccess.denied ? @tr("Camera: Blocked in System Settings")
        : cam-access == CamAccess.missing ? @tr("Camera: Not found")
        : "";

    callback new-room();
    callback open-link(string) -> bool;
    callback set-lang(string);
    callback join();
    callback hang-up();
    callback home();
    callback toggle-mic();
    callback pick-mic(string);
    callback pick-speaker(string);
    callback toggle-speaker();
    callback toggle-cam();
    callback pick-cam(string);
    callback set-portrait(bool);
    callback set-force-relay(bool);
    callback toggle-transcribe();
    callback send-chat(string) -> bool;
    callback screenshot(string, int);
    callback toggle-share();
    callback share-source(string);
    callback close-screen-picker();
    callback corner-moved(string, string);
    callback show-shot();
    callback update-now();
    changed phase => { keys.focus(); }

    title: "Call Danya";
    icon: Icons.video;
    min-width: 420px;
    min-height: 560px;
    preferred-width: 1100px;
    preferred-height: 760px;
    background: Theme.bg;
    default-font-size: Theme.font-size;

    // Clear of the phone's status and navigation bars, which the window is drawn under, and of the on-screen keyboard,
    // which covers it without resizing it; zero on desktop. Holds focus when nothing else does, so the phone's Back
    // key lands here; what no screen takes goes back to Android, which puts the app in the background.
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Back && root.phase == AppPhase.setup) {
                root.home();
                return accept;
            }
            reject
        }

        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - max(root.safe-area-insets.bottom, root.virtual-keyboard-size.height);

        if phase == AppPhase.start: StartScreen {
            version: root.version;
            update-version: root.update-version;
            update-progress: root.update-progress;
            update-now => { root.update-now(); }
            new-room => { root.new-room(); }
            open-link(link) => { root.open-link(link) }
            background-guide: root.background-guide;
            open-background-settings => { root.open-background-settings(); }
            dismiss-background-guide => { root.dismiss-background-guide(); }
            model-state: root.model-state;
            model-progress: root.model-progress;
            model-size: root.model-size;
            settings-open: root.settings-open;
            open-settings => { root.settings-open = true; }
            speech-prompt: root.speech-prompt;
            download-model => { root.download-model(); }
            dismiss-speech-prompt => { root.dismiss-speech-prompt(); }
        }

        if phase == AppPhase.setup: SetupScreen {
            lang: root.lang;
            mics: root.mics;
            mic-id: root.mic-id;
            mic-label: root.mic-label;
            speakers: root.speakers;
            speaker-id: root.speaker-id;
            speaker-label: root.speaker-label;
            pick-speaker(id) => { root.pick-speaker(id); }
            mic-on: root.mic-on;
            mic-level: root.mic-level;
            mic-status: root.mics.length == 0 ? @tr("Microphone: Not found") : "";
            video: root.self-video;
            video-rotation: root.self-frame-rotation;
            cam-on: root.cam-on;
            cam-granted: root.cam-access == CamAccess.granted;
            cam-pending: root.cam-access == CamAccess.pending;
            cams: root.cams;
            cam-id: root.cam-id;
            cam-label: root.cam-label;
            cam-status: root.cam-status;
            portrait: root.portrait;
            toggle-mic => { root.toggle-mic(); }
            toggle-cam => { root.toggle-cam(); }
            set-portrait(p) => { root.set-portrait(p); }
            set-lang(lang) => { root.set-lang(lang); }
            pick-mic(id) => { root.pick-mic(id); }
            pick-cam(id) => { root.pick-cam(id); }
            join => { root.join(); }
            back => { root.home(); }
        }

        if phase == AppPhase.starting || phase == AppPhase.waiting || phase == AppPhase.in-call: CallScreen {
            room-url: root.room-url;
            starting: phase == AppPhase.starting;
            connected: phase == AppPhase.in-call;
            reconnecting: root.reconnecting;
            link: root.link;
            elapsed: root.elapsed;
            mic-on: root.mic-on;
            has-mic: root.mics.length > 0;
            mics: root.mics;
            mic-id: root.mic-id;
            pick-mic(id) => { root.pick-mic(id); }
            speakers: root.speakers;
            speaker-id: root.speaker-id;
            speaker-off: root.speaker-off;
            peer-speaker-off: root.peer-speaker-off;
            pick-speaker(id) => { root.pick-speaker(id); }
            toggle-speaker => { root.toggle-speaker(); }
            cam-on: root.cam-on;
            cam-granted: root.cam-access == CamAccess.granted;
            cams: root.cams;
            cam-id: root.cam-id;
            portrait: root.portrait;
            peer-video: root.peer-video;
            screen-video: root.screen-video;
            remote-screen: root.remote-screen;
            sharing: root.sharing;
            screen-sources: root.screen-sources;
            corner-self: root.corner-self;
            corner-peer: root.corner-peer;
            corner-screen: root.corner-screen;
            toggle-share => { root.toggle-share(); }
            share-source(id) => { root.share-source(id); }
            close-screen-picker => { root.close-screen-picker(); }
            corner-moved(feed, corner) => { root.corner-moved(feed, corner); }
            peer-frame-rotation: root.peer-frame-rotation;
            peer-cam-on: root.peer-cam-on;
            self-video: root.self-video;
            self-frame-rotation: root.self-frame-rotation;
            stats: root.stats;
            force-relay: root.force-relay;
            show-stats: root.show-stats;
            open-settings => { root.settings-open = true; }
            chat: root.chat;
            others-count: root.others-count;
            subtitles: root.subtitles;
            subtitles-on: root.subtitles-on;
            transcribe-on: root.transcribe-on;
            speech-notice: root.speech-notice;
            speech-paused-until: root.speech-paused-until;
            peer-screenshot: root.peer-screenshot;
            saved-shot: root.saved-shot;
            shot-failures: root.shot-failures;
            screenshot(feed, rotation) => { root.screenshot(feed, rotation); }
            show-shot => { root.show-shot(); }
            toggle-transcribe => { root.toggle-transcribe(); }
            send-chat(text) => { root.send-chat(text) }
            // From the whole window, so the on-screen keyboard doesn't flip it
            stacked: root.width < 900px && root.height > root.width;
            touch: root.touch;
            keyboard-shown: root.virtual-keyboard-size.height > 0;
            pip: root.pip;
            outputs: root.outputs;
            output: root.output;
            pick-output(id) => { root.pick-output(id); }
            toggle-mic => { root.toggle-mic(); }
            toggle-cam => { root.toggle-cam(); }
            pick-cam(id) => { root.pick-cam(id); }
            set-portrait(p) => { root.set-portrait(p); }
            set-force-relay(r) => { root.set-force-relay(r); }
            hang-up => { root.hang-up(); }
        }

        if phase == AppPhase.full: Centered {
            icon: Icons.users;
            title: @tr("Room is full");
            body: @tr("This room already has two people in it.");
            Button {
                text: @tr("Start a new room");
                icon: Icons.plus;
                kind: ButtonKind.primary;
                clicked => { root.new-room(); }
            }
        }

        if phase == AppPhase.ended: Centered {
            icon: Icons.phone-off;
            title: @tr("Call ended");
            Button {
                text: @tr("Rejoin");
                icon: Icons.rotate-ccw;
                kind: ButtonKind.primary;
                clicked => { root.join(); }
            }
            Button {
                text: @tr("New room");
                icon: Icons.plus;
                clicked => { root.new-room(); }
            }
        }

        // Over whichever screen opened it; a phase change (the call ending) leaves it open
        if root.settings-open: SettingsSheet {
            sheet: root.touch || root.width < 900px;
            show-stats: root.show-stats;
            subtitles-on: root.subtitles-on;
            noise-suppression: root.noise-suppression;
            lang: root.lang;
            model-state: root.model-state;
            model-progress: root.model-progress;
            model-size: root.model-size;
            on-device: root.on-device;
            translation-state: root.translation-state;
            translation-progress: root.translation-progress;
            translation-size: root.translation-size;
            download-translation => { root.download-translation(); }
            delete-translation => { root.delete-translation(); }
            set-show-stats(on) => { root.set-show-stats(on); }
            set-subtitles-on(on) => { root.set-subtitles-on(on); }
            set-noise-suppression(on) => { root.set-noise-suppression(on); }
            set-lang(lang) => { root.set-lang(lang); }
            download-model => { root.download-model(); }
            cancel-download => { root.cancel-model-download(); }
            delete-model => { root.delete-model(); }
            set-on-device(on) => { root.set-on-device(on); }
            closed => {
                root.settings-open = false;
                keys.focus();
            }
        }

        // Offered while subtitles are on and it isn't downloaded, until put off; over Settings too, where the language
        // that needs it was just picked. Not on top of the first launch's speech question.
        if root.subtitles-on && !root.translation-dismissed && !root.speech-prompt
            && (root.translation-state == ModelState.missing || root.translation-state == ModelState.failed): ModelPrompt {
            icon: Icons.languages;
            title: @tr("Translate live subtitles on this device?");
            body: @tr("What the other person says shows in your language as they say it. It needs a one-time {} download; you can also do it later in Settings.", root.translation-size);
            download => {
                root.download-translation();
                root.translation-dismissed = true;
            }
            dismiss => { root.dismiss-translation-prompt(); }
        }
    }
}