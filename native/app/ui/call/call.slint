import { Theme } from "../theme.slint";
import { Icons } from "../components/icons.slint";
import { CopyLink } from "../components/copy-link.slint";
import { ControlPill } from "pill.slint";
import { Notice } from "notice.slint";
import { Feeds } from "feeds.slint";
import { StatsOverlay, StatsView } from "stats-overlay.slint";
import { DeviceItem } from "../setup/device-row.slint";
import { ChatPanel, ChatRow } from "../chat/chat.slint";
import { Button } from "../components/button.slint";
import { IconButton } from "../components/icon-button.slint";

export { StatsView, ChatRow }

export enum CallLink { none, connecting, connected, unstable, failed }

// The call: the other person fills the stage, the controls float over it. Before they're here a card with the
// room link sits on the stage instead, like the web's CallView.
export component CallScreen inherits Rectangle {
    in property <string> room-url;
    in property <bool> starting;
    in property <bool> connected;
    in property <bool> reconnecting;
    in property <CallLink> link;
    in property <string> elapsed;
    in property <bool> mic-on;
    in property <bool> has-mic;
    in property <[DeviceItem]> mics;
    in property <string> mic-id;
    callback pick-mic(string);
    in property <[DeviceItem]> speakers;
    in property <string> speaker-id;
    in property <bool> speaker-off;
    in property <bool> peer-speaker-off;
    callback pick-speaker(string);
    callback toggle-speaker();
    in property <bool> cam-on;
    in property <bool> cam-granted;
    in property <[DeviceItem]> cams;
    in property <string> cam-id;
    in property <bool> portrait;
    in property <image> peer-video;
    in property <image> screen-video;
    in property <bool> remote-screen;
    in property <bool> sharing;
    // Screens and windows to pick from where the OS has no picker of its own; the picker shows while it's not empty
    in property <[DeviceItem]> screen-sources;
    in property <string> corner-self;
    in property <string> corner-peer;
    in property <string> corner-screen;
    in property <int> peer-frame-rotation;
    in property <bool> peer-cam-on;
    in property <image> self-video;
    in property <int> self-frame-rotation;
    in property <StatsView> stats;
    in property <bool> force-relay;
    in property <[ChatRow]> chat;
    // The other person's messages so far; what the chat hasn't shown yet is the unread badge
    in property <int> others-count;
    // The other person's latest spoken line, and a counter that ticks when it or its translation arrives
    in property <string> subtitle;
    in property <int> subtitle-serial;
    in property <bool> transcribe-on;
    // 0 nothing to say, 1 the server has no speech model, 2 out of quota until speech-paused-until (a local time)
    in property <int> speech-notice;
    in property <string> speech-paused-until;
    in property <bool> peer-screenshot;
    // Where the last screenshot was saved; a new one shows the toast for a while
    in property <string> saved-shot;
    in property <int> shot-failures;
    // A phone held upright: the chat opens under the video instead of beside it, like the web's STACKED_QUERY
    in property <bool> stacked;
    // A touch screen, where the chat doesn't focus its box on opening
    in property <bool> touch;
    in property <bool> keyboard-shown;
    // Android's picture-in-picture window, too small for anything but the video
    in property <bool> pip;
    in property <[string]> outputs;
    in property <string> output;
    callback pick-output(string);
    callback toggle-mic();
    callback toggle-cam();
    callback pick-cam(string);
    callback set-portrait(bool);
    callback set-force-relay(bool);
    callback toggle-transcribe();
    callback send-chat(string) -> bool;
    // The feed on the stage ("peer", "screen" or "self") and the degrees it's turned, so the picture matches the screen
    callback screenshot(string, int);
    callback toggle-share();
    callback share-source(string);
    callback close-screen-picker();
    callback corner-moved(string, string);
    callback show-shot();
    callback hang-up();

    // Screen-only choices, reset for each new person like the web's
    property <int> user-rotation: 0;
    property <bool> stats-open: force-relay;
    changed connected => { if (!connected) { user-rotation = 0; } }

    // Open from the start on a wide window, like the web's (min-width: 900px)
    in-out property <bool> chat-open: root.width >= 900px;
    property <int> seen-count;
    property <int> unread: chat-open ? 0 : max(0, others-count - seen-count);
    changed others-count => { if (chat-open) { seen-count = others-count; } }
    changed chat-open => { if (chat-open) { seen-count = others-count; } subtitle-shown = false; }
    property <length> chat-width: min(360px, root.width * 0.42);
    property <length> chat-height: root.height * 0.58;

    // The controls fade off the video after a few seconds without input, like the web's useAutoHide; never while
    // waiting, with the pointer on the pill, or with the menu just opened
    property <bool> idle;
    property <bool> hovering-pill;
    property <bool> can-idle: connected && !hovering-pill && screen-sources.length == 0;
    changed can-idle => { wake(); }
    function wake() {
        idle = false;
        idle-timer.running = can-idle;
        idle-timer.restart();
    }
    idle-timer := Timer {
        interval: 3s;
        running: false;
        triggered => {
            self.running = false;
            root.idle = root.can-idle;
        }
    }

    property <bool> toast-shown;
    property <bool> shot-failed;
    changed saved-shot => {
        shot-failed = false;
        toast-shown = saved-shot != "";
        toast-timer.running = true;
        toast-timer.restart();
    }
    changed shot-failures => {
        shot-failed = true;
        toast-shown = true;
        toast-timer.running = true;
        toast-timer.restart();
    }
    toast-timer := Timer {
        interval: 5s;
        running: false;
        triggered => {
            self.running = false;
            root.toast-shown = false;
        }
    }

    property <bool> flash;
    flash-timer := Timer {
        interval: 50ms;
        running: false;
        triggered => {
            self.running = false;
            root.flash = false;
        }
    }

    property <bool> subtitle-shown;
    changed subtitle-serial => {
        if (!chat-open && subtitle != "") {
            subtitle-shown = true;
            subtitle-timer.running = true;
            subtitle-timer.restart();
        }
    }
    subtitle-timer := Timer {
        interval: 6s;
        running: false;
        triggered => {
            self.running = false;
            subtitle-shown = false;
        }
    }

    property <bool> shown: false;
    init => { shown = true; }

    background: #000;
    opacity: shown ? 1 : 0;
    animate opacity { duration: Theme.slow; easing: Theme.ease; }

    chat := ChatPanel {
        x: root.stacked ? 0 : root.width - self.width;
        y: root.stacked ? root.height - self.height : 0;
        width: root.stacked ? root.width : root.chat-open ? root.chat-width : 0;
        height: !root.stacked ? root.height : root.chat-open ? root.chat-height : 0;
        animate width, height { duration: Theme.slow; easing: Theme.ease; }
        messages: root.chat;
        open: root.chat-open;
        stacked: root.stacked;
        visible: !root.pip;
        focus-on-open: !root.touch;
        keyboard-shown: root.keyboard-shown;
        can-send: !root.reconnecting && !root.starting;
        send(text) => { root.send-chat(text) }
        close => { root.chat-open = false; }
    }

    // Everything but the chat; it narrows, or shortens when stacked, as the chat opens
    stage := Rectangle {
        x: 0;
        y: 0;
        width: root.width - (root.chat-open && !root.pip && !root.stacked ? root.chat-width : 0);
        height: root.height - (root.chat-open && !root.pip && root.stacked ? root.chat-height : 0);
        animate width, height { duration: Theme.slow; easing: Theme.ease; }
        clip: true;

        // Wakes the controls on any movement over the stage; under everything, so tiles get their own presses. A tap
        // also puts the on-screen keyboard away.
        TouchArea {
            mouse-cursor: root.idle ? none : default;
            moved => { root.wake(); }
            pointer-event(event) => { root.wake(); }
            clicked => { chat.blur(); }
        }

        feeds := Feeds {
            peer-video: root.peer-video;
            screen-video: root.screen-video;
            self-video: root.self-video;
            self-rotation: root.self-frame-rotation;
            peer-rotation: root.peer-frame-rotation + root.user-rotation;
            has-peer: root.connected;
            has-screen: root.connected && root.remote-screen;
            has-self: root.cam-granted;
            peer-cam-on: root.peer-cam-on;
            peer-speaker-off: root.peer-speaker-off;
            self-cam-on: root.cam-on && root.self-video.width > 0;
            pill-space: root.idle ? 20px : 96px;
            only-main: root.pip;
            corner-self: root.corner-self;
            corner-peer: root.corner-peer;
            corner-screen: root.corner-screen;
            corner-moved(feed, corner) => { root.corner-moved(feed, corner); }
            touched => {
                root.wake();
                chat.blur();
            }
        }

        if !connected && !root.pip: Rectangle {
            background: @radial-gradient(circle, #0000008c 0%, #00000040 70%);
            property <bool> card-shown: false;
            init => { card-shown = true; }

            Rectangle {
                width: min(440px, parent.width - 32px);
                height: content.preferred-height;
                y: (parent.height - self.height) / 2 + (card-shown ? 0 : 10px);
                opacity: card-shown ? 1 : 0;
                border-radius: Theme.radius-lg;
                border-width: 1px;
                border-color: Theme.glass-border;
                background: Theme.glass;
                drop-shadow-blur: 30px;
                drop-shadow-offset-y: 10px;
                drop-shadow-color: Theme.shadow;
                animate y, opacity { duration: Theme.slow; easing: Theme.ease; }

                content := VerticalLayout {
                    padding: 22px;
                    spacing: 14px;
                    Text {
                        text: starting ? @tr("Starting…") : @tr("Waiting for the other person to join…");
                        color: Theme.text;
                        font-weight: 550;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    CopyLink {
                        url: root.room-url;
                        fill: #0000004d;
                    }
                }
            }
        }

        // Below the macOS traffic lights, which sit over the content
        VerticalLayout {
            y: 40px;
            height: self.preferred-height;
            visible: !root.pip;
            alignment: start;
            spacing: 6px;

            if connected && elapsed != "": HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: timer.preferred-width + 24px;
                    height: timer.preferred-height + 8px;
                    border-radius: self.height / 2;
                    background: Theme.timer;
                    timer := Text {
                        text: elapsed;
                        color: #ffffffe6;
                        font-size: 13px;
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Notice {
                    text: reconnecting ? @tr("Lost connection to server, reconnecting…")
                        : !connected ? ""
                        : link == CallLink.connecting ? @tr("Connecting…")
                        : link == CallLink.unstable ? @tr("Connection unstable, reconnecting…")
                        : link == CallLink.failed ? @tr("Connection failed, retrying…")
                        : "";
                }
            }
            HorizontalLayout {
                alignment: center;
                Notice {
                    muted: true;
                    text: peer-screenshot ? @tr("The other person took a screenshot") : "";
                }
            }
            HorizontalLayout {
                alignment: center;
                Notice {
                    muted: true;
                    text: !transcribe-on ? ""
                    : speech-notice == 1 ? @tr("Speech-to-chat isn't available right now")
                    : speech-notice == 2 ? @tr("Speech-to-chat paused until {}: free limit reached", speech-paused-until)
                    : "";
                }
            }
        }

        // The camera flash, like the web's .shot-flash
        Rectangle {
            background: #fff;
            opacity: root.flash ? 0.8 : 0;
            animate opacity { duration: root.flash ? 0ms : 350ms; easing: Theme.ease; }
        }

        // Where the picture went, with a way to it
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - (root.idle ? 28px : 104px);
            animate y { duration: Theme.med; easing: Theme.ease; }
            width: toast.preferred-width;
            height: toast.preferred-height;
            border-radius: self.height / 2;
            border-width: 1px;
            border-color: Theme.glass-border;
            background: Theme.glass;
            opacity: root.toast-shown ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: Theme.med; easing: Theme.ease; }
            toast := HorizontalLayout {
                padding: 6px;
                padding-left: 16px;
                padding-right: root.shot-failed ? 16px : 6px;
                spacing: 10px;
                Text {
                    text: root.shot-failed ? @tr("Couldn't save the screenshot") : @tr("Screenshot saved");
                    color: Theme.text;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                if !root.shot-failed: Button {
                    // A phone has no folders to show: the picture opens in its photo viewer
                    text: root.touch ? @tr("Open") : @tr("Show in folder");
                    icon: Icons.folder-open;
                    height-hint: 32px;
                    font-size: 13px;
                    clicked => { root.show-shot(); }
                }
            }
        }

        // Their latest spoken line over the video while the chat is closed, like the web's Subtitle
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - (root.idle ? 28px : 104px);
            animate y { duration: Theme.med; easing: Theme.ease; }
            width: min(min(parent.width * 0.84, 720px), line.preferred-width + 32px);
            height: line.preferred-height + 16px;
            border-radius: Theme.radius;
            background: #000000b8;
            opacity: subtitle-shown && !chat-open && connected && !root.pip ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: Theme.med; easing: Theme.ease; }
            line := Text {
                width: parent.width - 32px;
                text: subtitle;
                color: #fff;
                font-size: 20px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }

        StatsOverlay {
            x: 14px;
            y: 40px;
            // Clear of the pill below it
            limit-width: parent.width - 28px;
            limit-height: parent.height - self.y - 100px;
            open: root.stats-open && root.connected && !root.pip;
            stats: root.stats;
            force-relay: root.force-relay;
            set-force-relay(relay) => { root.set-force-relay(relay); }
        }

        ControlPill {
            x: (parent.width - self.width) / 2;
            // Off the video while idle, like the web's .call.idle .pill; tucked lower and smaller over the stacked chat
            y: parent.height - self.height - (root.stacked && root.chat-open ? 10px : 20px) + (root.idle ? 24px : 0);
            button-size: root.stacked && root.chat-open ? 42px : root.width < 900px ? 46px : 48px;
            sheet: root.touch || root.width < 900px;
            area-x: root.absolute-position.x;
            area-y: root.absolute-position.y;
            area-width: root.width;
            area-height: root.height;
            gap: root.width < 900px ? 6px : 10px;
            opacity: root.idle ? 0 : 1;
            visible: !root.pip;
            animate y, opacity { duration: Theme.med; easing: Theme.ease; }
            hovered(h) => { root.hovering-pill = h; root.wake(); }
            mic-on: root.mic-on;
            has-mic: root.has-mic;
            mics: root.mics;
            mic-id: root.mic-id;
            pick-mic(id) => { root.pick-mic(id); }
            speakers: root.speakers;
            speaker-id: root.speaker-id;
            speaker-off: root.speaker-off;
            pick-speaker(id) => { root.pick-speaker(id); }
            toggle-speaker => { root.toggle-speaker(); }
            cam-on: root.cam-on;
            cam-granted: root.cam-granted;
            cams: root.cams;
            cam-id: root.cam-id;
            portrait: root.portrait;
            can-rotate: root.connected;
            stats-open: root.stats-open;
            can-screenshot: root.connected && (feeds.main-feed == "screen" ? root.screen-video.width > 0
                : feeds.main-feed == "peer" ? root.peer-cam-on && root.peer-video.width > 0
                : root.cam-on && root.self-video.width > 0);
            screenshot => {
                root.flash = true;
                flash-timer.running = true;
                flash-timer.restart();
                root.screenshot(feeds.main-feed,
                    feeds.main-feed == "peer" ? root.peer-frame-rotation + root.user-rotation
                    : feeds.main-feed == "self" ? root.self-frame-rotation : 0);
            }
            sharing: root.sharing;
            can-share: root.connected;
            outputs: root.outputs;
            output: root.output;
            pick-output(id) => { root.pick-output(id); }
            toggle-share => { root.toggle-share(); }
            transcribe-on: root.transcribe-on;
            chat-open: root.chat-open;
            unread: root.unread;
            toggle-transcribe => { root.toggle-transcribe(); }
            toggle-chat => { root.chat-open = !root.chat-open; }
            toggle-mic => { root.toggle-mic(); }
            toggle-cam => { root.toggle-cam(); }
            pick-cam(id) => { root.pick-cam(id); }
            toggle-portrait => { root.set-portrait(!root.portrait); }
            rotate => { root.user-rotation = Math.mod(root.user-rotation + 90, 360); }
            toggle-stats => { root.stats-open = !root.stats-open; }
            hang-up => { root.hang-up(); }
        }
    }

    // Where the OS has no picker of its own (Windows): which screen or window to share
    if screen-sources.length > 0: Rectangle {
        background: #0000008c;
        TouchArea { clicked => { root.close-screen-picker(); } }
        Rectangle {
            width: min(420px, parent.width - 32px);
            height: min(picker.preferred-height, parent.height - 64px);
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.glass-border;
            background: Theme.surface;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: Theme.shadow;
            TouchArea { }
            picker := VerticalLayout {
                padding: 18px;
                spacing: 6px;
                HorizontalLayout {
                    Text {
                        text: @tr("Share screen");
                        color: Theme.text;
                        font-weight: 650;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        icon: Icons.x;
                        label: @tr("Cancel");
                        size: 36px;
                        transparent: true;
                        clicked => { root.close-screen-picker(); }
                    }
                }
                Flickable {
                    min-height: 0;
                    preferred-height: list.preferred-height;
                    list := VerticalLayout {
                        for source in screen-sources: Rectangle {
                            height: 44px;
                            border-radius: Theme.radius-sm;
                            background: item.has-hover ? Theme.surface-3 : transparent;
                            accessible-role: button;
                            accessible-label: source.label;
                            accessible-action-default => { root.share-source(source.id); }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 12px;
                                Image {
                                    source: Icons.screen-share;
                                    colorize: Theme.muted;
                                    width: 18px;
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: source.label;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                            item := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.share-source(source.id); }
                            }
                        }
                    }
                }
            }
        }
    }
}
