import { Theme } from "../theme.slint";
import { Icons } from "../components/icons.slint";
import { IconButton, IconButtonKind } from "../components/icon-button.slint";
import { MenuPanel } from "menu-panel.slint";

// A pill button with a chevron beside it that opens a menu above, like the web's DeviceMenu: the button keeps its
// one-tap job (mute), the chevron holds the choices behind it (which device). Picking leaves the menu open, so the
// check shows the switch. The children are the menu's rows.
export component DeviceMenu inherits Rectangle {
    // The button
    in property <image> icon;
    in property <string> label;
    in property <IconButtonKind> kind;
    in property <bool> enabled: true;
    in property <length> size: 48px;
    in property <image> mark;
    callback clicked();
    // Without a menu it's the plain button: one camera has nothing to choose
    in property <bool> has-menu: true;
    // The chevron's name, also the menu's
    in property <string> menu-label;
    in property <string> footer-text;
    in property <image> footer-icon;
    in property <bool> footer-checked;
    in property <bool> footer-enabled: true;
    callback footer-activated();
    // A bottom sheet instead of a popover, over the call screen at this place in the window
    in property <bool> sheet;
    in property <length> area-x;
    in property <length> area-y;
    in property <length> area-width;
    in property <length> area-height;
    out property <bool> open: menu.is-open;

    changed has-menu => {
        if (!has-menu) {
            menu.close();
        }
    }

    // On the rail: the chevron is a small tab on the button's left, pointing at where its sheet's choices are
    in property <bool> tab;
    property <length> chevron-width: root.size < 48px ? 22px : 26px;

    width: root.has-menu && !root.tab ? root.size + root.chevron-width : root.size;
    height: root.size;
    border-radius: self.height / 2;
    background: has-menu && !tab ? Theme.split : transparent;

    IconButton {
        x: 0;
        icon: root.icon;
        label: root.label;
        kind: root.kind;
        enabled: root.enabled;
        size: root.size;
        mark: root.mark;
        clicked => { root.clicked(); }
    }
    if root.has-menu: Rectangle {
        x: root.tab ? -self.width - 2px : root.size;
        y: (root.height - self.height) / 2;
        width: root.tab ? 20px : root.chevron-width;
        height: root.tab ? 40px : root.size;
        border-top-left-radius: root.tab ? self.height / 2 : 0;
        border-bottom-left-radius: root.tab ? self.height / 2 : 0;
        border-width: root.tab ? 1px : 0;
        border-color: Theme.glass-border;
        background: root.tab ? Theme.glass : transparent;
        accessible-role: button;
        accessible-label: root.menu-label;
        accessible-action-default => { menu.show(); }
        Image {
            // Off center toward the button, like the web's padding-right
            x: root.tab ? (parent.width - self.width) / 2 : (parent.width - 4px - self.width) / 2;
            source: Icons.chevron-up;
            colorize: touch.has-hover || menu.is-open ? Theme.text : Theme.muted;
            width: 16px;
            height: 16px;
            transform-rotation: root.tab ? -90deg : 0deg;
            animate colorize { duration: Theme.fast; easing: Theme.ease; }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { menu.show(); }
        }
    }

    menu := PopupWindow {
        // Over the whole call screen: the panel places itself, and a press outside it closes it
        x: root.area-x - root.absolute-position.x;
        y: root.area-y - root.absolute-position.y;
        width: root.area-width;
        height: root.area-height;
        close-policy: no-auto-close;

        MenuPanel {
            sheet: root.sheet;
            label: root.menu-label;
            align-left: true;
            anchor-left: root.absolute-position.x - root.area-x;
            anchor-top: root.absolute-position.y - root.area-y;
            popover-width: 268px;
            footer-text: root.footer-text;
            footer-icon: root.footer-icon;
            footer-checked: root.footer-checked;
            footer-enabled: root.footer-enabled;
            footer-activated => { root.footer-activated(); }
            closed => { menu.close(); }
            @children
        }
    }
}
