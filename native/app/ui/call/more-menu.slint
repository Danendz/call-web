import { Theme } from "../theme.slint";
import { Icons } from "../components/icons.slint";
import { IconButton } from "../components/icon-button.slint";
import { DeviceItem, DeviceName } from "../setup/device-row.slint";
import { MenuPanel } from "menu-panel.slint";

component MenuItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback activated();

    height: 44px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover && enabled ? Theme.menu-hover : transparent;
    opacity: enabled ? 1 : 0.38;
    accessible-role: button;
    accessible-label: text;
    accessible-checked: checked;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { activated(); } }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Image {
            source: icon;
            colorize: Theme.text;
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Image {
            source: Icons.check;
            colorize: Theme.accent-hover;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            opacity: checked ? 1 : 0;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.activated(); }
    }
}

// The pill's ⋯ button and its menu, like the web's MoreMenu. Two cameras are a flip, more are listed to pick from.
export component MoreMenu inherits IconButton {
    in property <[DeviceItem]> cams;
    in property <string> cam-id;
    in property <bool> cam-granted;
    in property <bool> portrait;
    in property <bool> can-rotate;
    in property <bool> stats-open;
    in property <bool> can-screenshot;
    in property <bool> sharing;
    in property <bool> can-share;
    // Where the call's sound plays on a phone: "speaker", "earpiece", "bluetooth"; empty on desktop
    in property <[string]> outputs;
    in property <string> output;
    callback pick-output(string);
    callback screenshot();
    callback toggle-share();
    callback pick-cam(string);
    callback next-cam();
    callback toggle-portrait();
    callback rotate();
    callback toggle-stats();
    // A bottom sheet instead of a popover, on a phone or a narrow window
    in property <bool> sheet;
    // The call screen's place in the window, which the menu's popup covers
    in property <length> area-x;
    in property <length> area-y;
    in property <length> area-width;
    in property <length> area-height;
    out property <bool> open: menu.is-open;

    icon: Icons.ellipsis;
    label: @tr("More");
    clicked => { menu.show(); }

    menu := PopupWindow {
        // Over the whole call screen: the panel places itself, and a press outside it closes it
        x: root.area-x - root.absolute-position.x;
        y: root.area-y - root.absolute-position.y;
        width: root.area-width;
        height: root.area-height;
        close-policy: no-auto-close;

        panel := MenuPanel {
            sheet: root.sheet;
            label: root.label;
            anchor-right: root.absolute-position.x - root.area-x + root.width;
            anchor-top: root.absolute-position.y - root.area-y;
            closed => { menu.close(); }

            for id in root.outputs: MenuItem {
                icon: id == "bluetooth" ? Icons.bluetooth : id == "earpiece" ? Icons.phone : Icons.volume-2;
                text: id == "bluetooth" ? @tr("Bluetooth") : id == "earpiece" ? @tr("Phone earpiece") : @tr("Speaker");
                checked: id == root.output;
                activated => { panel.dismiss(); root.pick-output(id); }
            }
            if cam-granted && cams.length == 2: MenuItem {
                icon: Icons.switch-camera;
                text: @tr("Switch camera");
                activated => { panel.dismiss(); root.next-cam(); }
            }
            if cam-granted && cams.length > 2: VerticalLayout {
                for cam in cams: MenuItem {
                    icon: Icons.video;
                    text: DeviceName.of(cam.label, @tr("Camera"));
                    checked: cam.id == root.cam-id;
                    activated => { root.pick-cam(cam.id); panel.dismiss(); }
                }
            }
            MenuItem {
                icon: root.sharing ? Icons.screen-share-off : Icons.screen-share;
                text: root.sharing ? @tr("Stop sharing") : @tr("Share screen");
                enabled: root.can-share;
                activated => { panel.dismiss(); root.toggle-share(); }
            }
            MenuItem {
                icon: Icons.rectangle-vertical;
                text: @tr("Portrait video");
                checked: root.portrait;
                enabled: root.cam-granted;
                activated => { panel.dismiss(); root.toggle-portrait(); }
            }
            MenuItem {
                icon: Icons.rotate-cw;
                text: @tr("Rotate their video");
                enabled: root.can-rotate;
                activated => { panel.dismiss(); root.rotate(); }
            }
            MenuItem {
                icon: Icons.camera;
                text: @tr("Screenshot");
                enabled: root.can-screenshot;
                activated => { panel.dismiss(); root.screenshot(); }
            }
            MenuItem {
                icon: Icons.activity;
                text: @tr("Connection stats");
                checked: root.stats-open;
                activated => { panel.dismiss(); root.toggle-stats(); }
            }
        }
    }
}
