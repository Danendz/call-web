import { Theme } from "../theme.slint";
import { Icons } from "../components/icons.slint";
import { IconButton, IconButtonKind } from "../components/icon-button.slint";
import { DeviceItem } from "../setup/device-row.slint";
import { MoreMenu } from "more-menu.slint";

// Floating call controls at the bottom of the stage, like the web's ControlPill.
export component ControlPill inherits Rectangle {
    in property <bool> mic-on;
    in property <bool> has-mic;
    in property <bool> cam-on;
    in property <bool> cam-granted;
    in property <[DeviceItem]> cams;
    in property <string> cam-id;
    in property <bool> portrait;
    in property <bool> can-rotate;
    in property <bool> stats-open;
    in property <bool> transcribe-on;
    in property <bool> chat-open;
    in property <int> unread;
    in property <bool> can-screenshot;
    in property <bool> sharing;
    in property <bool> can-share;
    in property <[string]> outputs;
    in property <string> output;
    callback pick-output(string);
    // Smaller on a phone, like the web's narrow .pill
    in property <length> button-size: 48px;
    in property <length> gap: 10px;
    callback screenshot();
    callback toggle-share();
    // The pointer is over the pill: the controls stay up meanwhile
    callback hovered(bool);
    callback toggle-transcribe();
    callback toggle-chat();
    callback toggle-mic();
    callback toggle-cam();
    callback pick-cam(string);
    callback next-cam();
    callback toggle-portrait();
    callback rotate();
    callback toggle-stats();
    callback hang-up();

    width: row.preferred-width;
    height: row.preferred-height;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: Theme.glass-border;
    background: Theme.glass;
    drop-shadow-blur: 30px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: Theme.shadow;

    hover := TouchArea {
        changed has-hover => { root.hovered(self.has-hover); }
    }

    row := HorizontalLayout {
        padding: root.gap < 10px ? 4px : 8px;
        // The web's extra margin before hang up
        spacing: root.gap + 6px;

        HorizontalLayout {
            spacing: root.gap;
            IconButton {
                size: root.button-size;
                icon: mic-on && has-mic ? Icons.mic : Icons.mic-off;
                label: mic-on ? @tr("Turn off microphone") : @tr("Turn on microphone");
                kind: has-mic && !mic-on ? IconButtonKind.off : IconButtonKind.normal;
                enabled: has-mic;
                clicked => { root.toggle-mic(); }
            }
            IconButton {
                size: root.button-size;
                icon: cam-on && cam-granted ? Icons.video : Icons.video-off;
                label: cam-on ? @tr("Turn off camera") : @tr("Turn on camera");
                kind: cam-granted && !cam-on ? IconButtonKind.off : IconButtonKind.normal;
                enabled: cam-granted;
                clicked => { root.toggle-cam(); }
            }
            IconButton {
                size: root.button-size;
                icon: Icons.captions;
                label: @tr("Speech to chat");
                kind: transcribe-on ? IconButtonKind.active : IconButtonKind.normal;
                enabled: has-mic;
                clicked => { root.toggle-transcribe(); }
            }
            IconButton {
                size: root.button-size;
                icon: Icons.message-square;
                label: @tr("Chat");
                kind: chat-open ? IconButtonKind.active : IconButtonKind.normal;
                badge: chat-open ? 0 : unread;
                clicked => { root.toggle-chat(); }
            }
            MoreMenu {
                size: root.button-size;
                cams: root.cams;
                cam-id: root.cam-id;
                cam-granted: root.cam-granted;
                portrait: root.portrait;
                can-rotate: root.can-rotate;
                stats-open: root.stats-open;
                can-screenshot: root.can-screenshot;
                sharing: root.sharing;
                can-share: root.can-share;
                outputs: root.outputs;
                output: root.output;
                pick-output(id) => { root.pick-output(id); }
                screenshot => { root.screenshot(); }
                toggle-share => { root.toggle-share(); }
                pick-cam(id) => { root.pick-cam(id); }
                next-cam => { root.next-cam(); }
                toggle-portrait => { root.toggle-portrait(); }
                rotate => { root.rotate(); }
                toggle-stats => { root.toggle-stats(); }
            }
        }
        IconButton {
            size: root.button-size;
            icon: Icons.phone-off;
            label: @tr("Hang up");
            kind: IconButtonKind.danger;
            clicked => { root.hang-up(); }
        }
    }
}
