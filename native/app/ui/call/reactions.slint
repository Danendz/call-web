import { Theme } from "../theme.slint";
import { Icons } from "../components/icons.slint";
import { IconButton, IconButtonKind } from "../components/icon-button.slint";
import { EmojiGrid } from "emoji.slint";

// One reaction flying up, like the web's .floater. `x` is a share of the width; `count` how many of the same in a
// row it ends, shown from 2.
export struct Floater {
    id: int,
    emoji: string,
    x: float,
    drift: length,
    count: int,
}

// A piece of a full-screen effect, like the web's effects.ts: an emoji (hearts, flames) or, with no glyph, a strip
// of confetti. Confetti falls from the top; the rest rises from the bottom edge.
export struct Spark {
    glyph: string,
    color: color,
    x: float,
    delay: duration,
    life: duration,
    // Screen heights a second, up for glyphs and down for confetti
    speed: float,
    size: length,
    spin: float,
    phase: float,
    // Flames grow and then shrink as they burn out
    burns: bool,
}

// The quick reactions, first in the emoji panel: the same as REACTIONS in shared/protocol.ts and crates/protocol
global ReactionChoices {
    out property <[string]> emoji: ["❤️", "😂", "👍", "😮", "😢", "🔥", "🎉", "👏"];
}

component FloatingEmoji inherits Rectangle {
    in property <string> emoji;
    in property <int> count;
    in property <length> drift;
    // How far it rises over its life
    in property <length> rise;

    property <duration> born;
    init => { born = animation-tick(); }
    // 0 to 1 over the 3 s the Rust side keeps it for; animation-tick() redraws every frame while one is up
    property <float> t: min(1, (animation-tick() - born) / 3000ms);
    property <float> age: (animation-tick() - born) / 1s;

    width: glyph.preferred-width;
    height: glyph.preferred-height;
    // The web's float-up: pops in, rises slowing down, fades over the last third. Reduced motion only fades.
    property <float> eased: 1 - (1 - t) * (1 - t);
    opacity: t < 0.1 ? t * 10 : t > 0.7 ? (1 - t) / 0.3 : 1;

    glyph := Text {
        x: Theme.reduced-motion ? 0 : root.drift * Math.sin(root.age * 1rad * 2.85);
        y: Theme.reduced-motion ? 0 : -root.rise * root.eased;
        transform-rotation: Theme.reduced-motion ? 0 : 8deg * Math.sin(root.age * 1rad * 2.85);
        transform-scale: Theme.reduced-motion ? 1
            : root.t < 0.1 ? 0.3 + root.t * 8.5
            : root.t < 0.2 ? 1.15 - (root.t - 0.1) * 1.5
            : 1 - (root.t - 0.2) * 0.12;
        text: root.emoji;
        font-size: 36px + min(root.count, 8) * 4px;
    }

    if root.count > 1: Rectangle {
        x: glyph.x + glyph.width * 0.85;
        y: glyph.y - 4px;
        width: count-text.preferred-width + 12px;
        height: 20px;
        border-radius: self.height / 2;
        background: Theme.accent;
        count-text := Text {
            text: "×" + root.count;
            color: #fff;
            font-size: 13px;
            font-weight: 700;
        }
    }

    // The web's .burst: small copies flying out from the middle at a combo
    if root.count > 1 && !Theme.reduced-motion: Rectangle {
        property <float> k: min(1, root.age / 0.6);
        for i in 6: Text {
            property <angle> a: i * 60deg;
            x: glyph.width / 2 - self.width / 2 + Math.sin(a) * 56px * k;
            y: glyph.height / 2 - self.height / 2 - Math.cos(a) * 56px * k;
            text: root.emoji;
            font-size: 14px;
            opacity: 1 - k;
            transform-scale: 1 - k * 0.6;
        }
    }
}

component SparkView inherits Rectangle {
    in property <Spark> spark;
    in property <length> area-width;
    in property <length> area-height;

    property <duration> born;
    init => { born = animation-tick(); }
    property <float> age: (animation-tick() - born - spark.delay) / 1s;
    property <float> k: age / (spark.life / 1s);

    visible: age >= 0 && k <= 1;
    opacity: min(1, age * 6) * (k > 0.7 ? (1 - k) / 0.3 : 1);
    x: area-width * spark.x + 14px * Math.sin((age * 3 + spark.phase) * 1rad) - self.width / 2;
    // Confetti falls with gravity from above the top; the rest rises from below the bottom
    y: spark.glyph == "" ? -40px + area-height * (spark.speed * age + 0.9 * age * age)
        : area-height + 40px - area-height * spark.speed * age;
    width: spark.glyph == "" ? spark.size : glyph.preferred-width;
    height: spark.glyph == "" ? spark.size / 2 : glyph.preferred-height;
    transform-rotation: spark.spin * age * 1rad;
    transform-scale: spark.burns ? max(0, Math.sin(min(k * 1.2, 1) * 180deg)) : 1;
    background: spark.glyph == "" ? spark.color : transparent;

    glyph := Text {
        text: spark.glyph;
        font-size: spark.size;
    }
}

// Reactions flying up over the video, both yours and theirs, and a combo's full-screen effect. Takes no input.
export component ReactionsOverlay inherits Rectangle {
    in property <[Floater]> floaters;
    in property <[Spark]> sparks;
    // Where they start: above the pill
    in property <length> bottom-space;

    clip: true;

    for s in root.sparks: SparkView {
        spark: s;
        area-width: root.width;
        area-height: root.height;
    }

    for f in root.floaters: FloatingEmoji {
        x: root.width * f.x - self.width / 2;
        y: root.height - root.bottom-space - self.height;
        emoji: f.emoji;
        count: f.count;
        drift: f.drift;
        rise: root.height * 0.5;
    }
}

// The pill's emoji button and its panel, like the web's ReactionBar: the quick reactions, then the grid of the rest.
// Each tap sends one, which flies over the video and shows in the chat. Stays open for tapping again and again; a
// press outside it closes it.
export component ReactionMenu inherits IconButton {
    callback react(string);
    // The call screen's place in the window, which the popup covers
    in property <length> area-x;
    in property <length> area-y;
    in property <length> area-width;
    in property <length> area-height;
    // Above the pill, centered on its middle; or, on the rail, to its left from its bottom
    in property <bool> rail;
    in property <length> anchor-center;
    in property <length> anchor-top;
    in property <length> anchor-left;
    in property <length> anchor-bottom;
    out property <bool> open: menu.is-open;

    icon: Icons.smile-plus;
    label: @tr("React");
    kind: menu.is-open ? IconButtonKind.active : IconButtonKind.normal;
    clicked => { menu.show(); }

    menu := PopupWindow {
        x: root.area-x - root.absolute-position.x;
        y: root.area-y - root.absolute-position.y;
        width: root.area-width;
        height: root.area-height;
        close-policy: no-auto-close;

        TouchArea { clicked => { menu.close(); } }

        panel := Rectangle {
            property <bool> shown: false;
            init => { shown = true; }
            width: root.rail ? min(340px, root.anchor-left - 20px) : min(360px, root.area-width - 24px);
            height: content.preferred-height;
            x: root.rail ? root.anchor-left - self.width - 8px + (shown ? 0 : 8px)
                : max(12px, min(root.area-width - self.width - 12px, root.anchor-center - self.width / 2));
            y: (root.rail ? root.anchor-bottom - self.height : root.anchor-top - self.height - 12px) + (shown || root.rail ? 0 : 8px);
            opacity: shown ? 1 : 0;
            animate x, y, opacity { duration: Theme.med; easing: Theme.ease-spring; }
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.glass-border;
            background: Theme.glass;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: Theme.shadow;
            clip: true;
            accessible-role: groupbox;
            accessible-label: @tr("React");
            // Presses between the buttons stay in the panel
            TouchArea { }

            content := VerticalLayout {
                HorizontalLayout {
                    padding: 6px;
                    spacing: 2px;
                    height: 52px;
                    for emoji in ReactionChoices.emoji: Rectangle {
                        horizontal-stretch: 1;
                        border-radius: self.height / 2;
                        background: touch.has-hover ? Theme.menu-hover : transparent;
                        accessible-role: button;
                        accessible-label: emoji;
                        accessible-action-default => { root.react(emoji); }
                        Text {
                            text: emoji;
                            font-size: 24px;
                            transform-scale: touch.pressed ? 0.85 : touch.has-hover ? 1.15 : 1;
                            animate transform-scale { duration: Theme.fast; easing: Theme.ease-spring; }
                        }
                        touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.react(emoji); }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                EmojiGrid {
                    max-grid: min(210px, root.area-height * 0.3);
                    picked(e) => { root.react(e); }
                }
            }
        }
    }
}
