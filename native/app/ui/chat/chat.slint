import { Theme } from "../theme.slint";
import { Icons } from "../components/icons.slint";

// One line as the bridge words it (the web's useFeed): the other person's in your language with what they wrote
// under it, your own as written, and what they're saying right now as the last one
export struct ChatRow {
    // What showed when it came: their spoken words translated on this device when it can be
    first: string,
    // The server's translation, which crossfades over `first`
    text: string,
    translated: bool,
    original: string,
    mine: bool,
    spoken: bool,
    // What they're saying right now
    live: bool,
    // Waiting the few ms its translation here takes, rather than flash the original
    pending: bool,
    // A reaction, or a run of the same one: the emoji big
    reaction: bool,
}

// See-through like the web's: theirs dark on the left, yours accent on the right. Rises in like msg-in, and fades
// out as it nears the top of the list, where the web masks it.
component Bubble inherits HorizontalLayout {
    in property <ChatRow> message;
    in property <length> max-bubble;
    // Where the top of the list is, from the bubble's own top: it fades over the band below it
    in property <length> from-top;
    in property <length> fade;
    property <bool> entered;
    init => { entered = true; }
    property <bool> shown: entered && !message.pending;

    alignment: message.mine ? end : start;
    Rectangle {
        max-width: root.max-bubble;
        border-top-left-radius: 18px;
        border-top-right-radius: 18px;
        border-bottom-left-radius: message.mine ? 18px : 6px;
        border-bottom-right-radius: message.mine ? 6px : 18px;
        background: message.mine ? Theme.bubble-mine : Theme.bubble;
        border-width: message.mine ? 0px : 1px;
        border-color: Theme.glass-border;
        opacity: (shown ? 1 : 0) * clamp((root.from-top + self.height / 2) / root.fade, 0, 1);
        transform-scale: shown ? 1 : 0.96;
        transform-origin: { x: message.mine ? self.width : 0, y: self.height };
        animate transform-scale { duration: Theme.med; easing: Theme.ease; }
        accessible-role: text;
        accessible-label: message.translated ? message.text : message.first;

        VerticalLayout {
            padding-left: message.reaction ? 10px : 12px;
            padding-right: message.reaction ? 10px : 12px;
            padding-top: message.reaction ? 4px : 7px;
            padding-bottom: message.reaction ? 4px : 7px;
            spacing: 3px;
            HorizontalLayout {
                spacing: 5px;
                if message.spoken: Image {
                    source: Icons.mic;
                    colorize: #ffffffb3;
                    width: 13px;
                    height: 13px;
                    y: 3px;
                    accessible-role: image;
                    accessible-label: @tr("Spoken");
                }
                // The translation crossfades over what was shown first, both in one box so it doesn't jump
                Rectangle {
                    horizontal-stretch: 1;
                    preferred-width: max(first-text.preferred-width, final-text.preferred-width);
                    min-height: max(first-text.preferred-height, final-text.preferred-height);
                    first-text := Text {
                        y: 0;
                        width: parent.width;
                        text: message.first;
                        color: #fff;
                        font-size: message.reaction ? 22px : Theme.font-size;
                        wrap: word-wrap;
                        opacity: message.translated ? 0 : 1;
                        animate opacity { duration: Theme.slow; easing: Theme.ease; }
                    }
                    final-text := Text {
                        y: 0;
                        width: parent.width;
                        text: message.translated ? message.text : "";
                        color: #fff;
                        wrap: word-wrap;
                        opacity: message.translated ? 1 : 0;
                        animate opacity { duration: Theme.slow; easing: Theme.ease; }
                    }
                }
            }
            if message.original != "": Text {
                text: message.original;
                color: #ffffffb3;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}

// The chat over the video in the lower left, like the web's ChatOverlay: no panel, only bubbles, the oldest fading
// out at the top and the rest a scroll back. It keeps its draft while hidden.
export component ChatOverlay inherits Rectangle {
    in property <[ChatRow]> messages;
    in property <bool> open;
    in property <bool> can-send;
    // The controls faded off the video: so does the message box, unless it's in use
    in property <bool> idle;
    // How tall the list may grow before it scrolls
    in property <length> max-list;
    // Room the messages leave on the right, for the phone's rail above the message box
    in property <length> list-clear;
    // Only with a mouse and keyboard: on a touch screen focusing would pop the on-screen keyboard over the call
    in property <bool> focus-on-open: true;
    // The on-screen keyboard is up; once it's put away (Back, or its own button) the box lets go too
    in property <bool> keyboard-shown;
    changed keyboard-shown => {
        if (!keyboard-shown && input.has-focus) {
            keys.focus();
        }
    }
    callback send(string) -> bool;

    // Where scrolled-back lines fade out
    property <length> fade: 48px;
    property <bool> holding: input.has-focus || input.text != "";

    height: content.preferred-height;
    opacity: open ? 1 : 0;
    visible: self.opacity > 0;
    animate opacity { duration: Theme.med; easing: Theme.ease; }
    accessible-role: groupbox;
    accessible-label: @tr("Chat");

    // Lets go of the message box, which puts the on-screen keyboard away. Focus moves to the chat itself rather than
    // nowhere, so the phone's Back key still reaches the window.
    public function blur() {
        keys.focus();
    }

    keys := FocusScope {
        content := VerticalLayout {
            y: root.open ? 0 : 12px;
            animate y { duration: Theme.med; easing: Theme.ease; }
            spacing: 8px;

            if messages.length == 0: Text {
                text: @tr("No messages yet. They disappear when the room closes.");
                width: root.width - root.list-clear;
                color: #ffffffbf;
                font-size: 13px;
                wrap: word-wrap;
                opacity: root.idle ? 0 : 1;
                animate opacity { duration: Theme.med; easing: Theme.ease; }
            }
            list := Flickable {
                // Grows with its lines, then scrolls; the band at the top is where lines fade, so a short list shows whole
                height: min(column.preferred-height, root.max-list);
                content-height: column.preferred-height;
                property <int> count: messages.length;
                // New lines scroll into view, like the web's: unless scrolled back to read
                property <bool> stuck: true;
                changed content-y => { self.stuck = self.content-y <= self.height - self.content-height + 24px; }
                changed count => { if (self.stuck) { stick.running = true; } }
                changed content-height => { if (self.stuck) { stick.running = true; } }

                // A tap between the lines puts the keyboard away
                TouchArea {
                    width: list.width;
                    height: max(list.height, column.preferred-height);
                    clicked => { root.blur(); }
                }
                column := VerticalLayout {
                    width: list.width;
                    padding-top: root.fade;
                    padding-right: root.list-clear;
                    spacing: 6px;
                    for row in messages: Bubble {
                        message: row;
                        max-bubble: (root.width - root.list-clear) * 0.85;
                        from-top: self.y + list.content-y;
                        fade: root.fade;
                    }
                }
            }

            // Stays while typing even when the controls fade
            HorizontalLayout {
                spacing: 8px;
                opacity: root.idle && !root.holding ? 0 : 1;
                animate opacity { duration: Theme.med; easing: Theme.ease; }
                Rectangle {
                    height: 44px;
                    horizontal-stretch: 1;
                    border-radius: self.height / 2;
                    border-width: 1px;
                    border-color: input.has-focus ? Theme.accent : Theme.glass-border;
                    background: Theme.glass;
                    animate border-color { duration: Theme.fast; easing: Theme.ease; }
                    Text {
                        x: 16px;
                        text: @tr("Message");
                        color: Theme.muted;
                        visible: input.text == "";
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    input := TextInput {
                        x: 16px;
                        width: parent.width - 32px;
                        height: parent.height;
                        color: Theme.text;
                        vertical-alignment: center;
                        single-line: true;
                        accessible-label: @tr("Message");
                        accepted => { send-button.clicked(); }
                    }
                }
                send-button := Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: self.height / 2;
                    property <bool> enabled: root.can-send && input.text != "";
                    background: !enabled ? Theme.glass : touch.has-hover ? Theme.accent-hover : Theme.accent;
                    animate background { duration: Theme.fast; easing: Theme.ease; }
                    accessible-role: button;
                    accessible-label: @tr("Send");
                    accessible-enabled: enabled;
                    accessible-action-default => { self.clicked(); }
                    callback clicked();
                    clicked => {
                        if (self.enabled && root.send(input.text)) {
                            input.text = "";
                            list.stuck = true;
                        }
                    }
                    Image {
                        source: Icons.send-horizontal;
                        colorize: parent.enabled ? #fff : Theme.muted;
                        width: 18px;
                        height: 18px;
                    }
                    touch := TouchArea {
                        mouse-cursor: parent.enabled ? pointer : default;
                        clicked => { parent.clicked(); }
                    }
                }
            }
        }
    }

    // The list's height settles a frame after a row is added, so the scroll waits for it
    stick := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            list.content-y = min(0px, list.height - list.content-height);
        }
    }

    // Focus the message box when the chat is shown again, as the web does on a desktop, and let go of it when hidden
    changed open => {
        if (open && focus-on-open) {
            input.focus();
        } else if (!open && input.has-focus) {
            keys.focus();
        }
    }
}
