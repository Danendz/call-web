import { Theme } from "../theme.slint";
import { Icons } from "icons.slint";
import { Button, ButtonKind } from "button.slint";

// The room's web address with a copy button, like the web's CopyLink. `label` names other things to copy.
export component CopyLink inherits Rectangle {
    in property <string> url;
    in property <string> label: @tr("Room link");
    in property <color> fill: Theme.surface-2;
    property <bool> copied: false;

    height: 46px;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: Theme.border;
    background: fill;

    HorizontalLayout {
        padding: 4px;
        padding-left: 14px;
        spacing: 4px;

        // A long link would size the field to all of its text and push Copy off screen; it's cut off instead
        Rectangle {
            horizontal-stretch: 1;
            min-width: 0;
            preferred-width: 0;
            clip: true;

            field := TextInput {
                width: 100%;
                height: 100%;
                text: root.url;
                read-only: true;
                single-line: true;
                color: Theme.muted;
                font-size: Theme.font-size-small;
                vertical-alignment: center;
                accessible-label: root.label;
            }
        }

        Button {
            text: copied ? @tr("Copied") : @tr("Copy");
            icon: copied ? Icons.check : Icons.copy;
            kind: copied ? ButtonKind.success : ButtonKind.normal;
            height-hint: 36px;
            font-size: Theme.font-size-small;
            clicked => {
                field.select-all();
                field.copy();
                field.clear-selection();
                copied = true;
                reset.running = true;
            }
        }
    }

    reset := Timer {
        interval: 1500ms;
        running: false;
        triggered => {
            copied = false;
            self.running = false;
        }
    }
}
