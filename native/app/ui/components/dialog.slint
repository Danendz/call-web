import { Theme } from "../theme.slint";

// A card over a dimmed backdrop that rises and fades in, and back out before it's gone; on a phone a sheet that slides
// up from the bottom, which stays put as the keyboard or its own content changes its height, where a centered card
// would jump. Ask it to go with dismiss(); the owner removes it on closed(). A click outside the card or Esc/Back
// dismisses it unless it's `required`.
export component Dialog inherits Rectangle {
    in property <length> card-width: 420px;
    // From the bottom instead of the middle
    in property <bool> sheet;
    // Has to be answered: the backdrop and Esc/Back don't close it
    in property <bool> required;
    // False starts it going, like dismiss(): for an owner whose reason to show it went away
    in property <bool> open: true;
    // A click on the card, outside what's in it
    callback card-clicked();
    // Gone from screen: remove it now
    callback closed();

    property <bool> shown;
    property <bool> closing;

    // Opens a tick after the first frame: set in init, there would be nothing to animate from
    enter-timer := Timer {
        interval: 1ms;
        triggered => {
            self.running = false;
            root.shown = true;
        }
    }

    exit-timer := Timer {
        interval: root.sheet ? Theme.sheet : Theme.med;
        running: false;
        triggered => {
            self.running = false;
            root.closed();
        }
    }

    public function dismiss() {
        if (closing) {
            return;
        }
        closing = true;
        shown = false;
        exit-timer.running = true;
        // Out of any field in the card: one removed while focused leaves the on-screen keyboard up
        keys.focus();
    }

    changed open => {
        if (!open) {
            dismiss();
        }
    }

    background: !shown ? #00000000 : sheet ? Theme.sheet-dim : #00000099;
    animate background { duration: sheet ? Theme.sheet : Theme.med; easing: sheet ? Theme.ease-sheet : Theme.ease; }

    TouchArea {
        clicked => {
            if (!root.required) {
                root.dismiss();
            }
        }
    }

    // Holds Esc/Back as it bubbles up from a field in the card, or when nothing in it has focus
    keys := FocusScope {
        key-pressed(event) => {
            if (!root.required && (event.text == Key.Escape || event.text == Key.Back)) {
                root.dismiss();
                return accept;
            }
            reject
        }

        Rectangle {
            // How far below its place the sheet is as it slides in or out, closed past the phone's home indicator or
            // navigation bar, which the window goes on under. Apart from y, so the sheet stays on the keyboard as it
            // moves, which an animation of y would trail; from the content's height, which doesn't change as the
            // keyboard goes, so the slide isn't started again
            property <length> slide: root.shown ? 0 : content.preferred-height + 80px;
            width: root.sheet ? min(root.width, 520px) : min(root.card-width, root.width - 32px);
            height: min(content.preferred-height, root.height - (root.sheet ? 16px : 32px));
            y: root.sheet ? root.height - self.height + self.slide : (root.height - self.height) / 2 + (root.shown ? 0 : 10px);
            opacity: root.sheet || root.shown ? 1 : 0;
            border-radius: Theme.radius-lg;
            border-bottom-left-radius: root.sheet ? 0 : Theme.radius-lg;
            border-bottom-right-radius: root.sheet ? 0 : Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.glass-border;
            background: Theme.surface;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: root.sheet ? 0 : 10px;
            drop-shadow-color: Theme.shadow;
            clip: !root.sheet;
            animate y { duration: root.sheet ? 0ms : Theme.med; easing: Theme.ease; }
            animate slide { duration: Theme.sheet; easing: Theme.ease-sheet; }
            animate opacity { duration: Theme.med; easing: Theme.ease; }

            // Under the sheet's bottom edge, so its spring shows no gap
            if root.sheet: Rectangle {
                y: parent.height - 1px;
                height: 80px;
                background: Theme.surface;
            }

            // Swallows clicks so they don't reach the backdrop
            TouchArea { clicked => { root.card-clicked(); } }

            // Scrolls when a short window can't fit it
            Flickable {
                content-height: content.preferred-height;
                // Slint scrolls a focused field clear of the on-screen keyboard; the sheet already sits on it, and a
                // field it caught mid-slide would be scrolled away and back
                changed content-y => {
                    if (content.preferred-height <= self.height) {
                        self.content-y = 0;
                    }
                }
                content := VerticalLayout {
                    width: parent.width;
                    padding: 22px;
                    spacing: 14px;
                    @children
                }
            }
        }
    }

    // Focus for Esc/Back, unless what's inside takes it for a field
    public function focus-keys() {
        keys.focus();
    }
}
