import { Theme } from "../theme.slint";

// A labeled one-line text box, like the web's inputs. `secret` hides what's typed (passwords).
export component Field inherits VerticalLayout {
    in property <string> label;
    // Under the box, in small muted text
    in property <string> hint;
    in property <string> placeholder;
    in property <bool> secret;
    in property <bool> invalid;
    in-out property <string> text;
    callback accepted();
    callback edited();

    spacing: 6px;

    public function focus-input() {
        input.focus();
    }

    public function clear() {
        input.text = "";
    }

    if root.label != "": Text {
        text: root.label;
        color: Theme.text;
        font-size: Theme.font-size-small;
        font-weight: 550;
    }
    Rectangle {
        height: 44px;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: root.invalid ? Theme.bad : input.has-focus ? Theme.accent : Theme.border;
        background: Theme.surface-2;
        animate border-color { duration: Theme.fast; easing: Theme.ease; }

        input := TextInput {
            x: 14px;
            width: parent.width - 28px;
            text <=> root.text;
            single-line: true;
            input-type: root.secret ? InputType.password : InputType.text;
            color: Theme.text;
            font-size: Theme.font-size;
            vertical-alignment: center;
            accessible-label: root.label != "" ? root.label : root.placeholder;
            accepted => { root.accepted(); }
            edited => { root.edited(); }
        }
        Text {
            x: 14px;
            text: root.placeholder;
            color: Theme.muted;
            font-size: Theme.font-size;
            vertical-alignment: center;
            height: parent.height;
            visible: input.text == "" && root.placeholder != "";
        }
    }
    if root.hint != "": Text {
        text: root.hint;
        color: Theme.muted;
        font-size: 12px;
        wrap: word-wrap;
    }
}
