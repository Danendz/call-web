import { Theme } from "../theme.slint";

export struct SegmentOption {
    id: string,
    name: string,
}

// Two or three options side by side, the picked one on a sliding highlight.
export component Segmented inherits Rectangle {
    in property <[SegmentOption]> options;
    in property <string> value;
    callback picked(string);
    // Slint can't search a list, and two or three options don't need to
    property <int> picked-index: root.value == root.options[0].id ? 0 : root.value == root.options[1].id ? 1 : 2;
    property <length> segment: (self.width - 6px) / max(1, root.options.length);

    height: 36px;
    width: root.options.length * 90px;
    border-radius: self.height / 2;
    background: Theme.surface-3;

    Rectangle {
        y: 3px;
        x: 3px + root.picked-index * root.segment;
        width: root.segment;
        height: parent.height - 6px;
        border-radius: self.height / 2;
        background: Theme.accent;
        animate x { duration: Theme.med; easing: Theme.ease-spring; }
    }

    HorizontalLayout {
        padding: 3px;
        for option in root.options: TouchArea {
            mouse-cursor: pointer;
            clicked => { root.picked(option.id); }
            accessible-role: button;
            accessible-label: option.name;
            accessible-checked: root.value == option.id;
            accessible-action-default => { root.picked(option.id); }
            Text {
                text: option.name;
                color: root.value == option.id ? #fff : Theme.muted;
                font-size: Theme.font-size-small;
                font-weight: 550;
                horizontal-alignment: center;
                vertical-alignment: center;
                animate color { duration: Theme.fast; easing: Theme.ease; }
            }
        }
    }
}
