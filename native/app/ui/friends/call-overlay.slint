import { Theme } from "../theme.slint";
import { Icons } from "../components/icons.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { IconButton } from "../components/icon-button.slint";

// What can be done with the call: answer an incoming one, cancel yours, or dismiss how it ended
component Buttons inherits HorizontalLayout {
    in property <bool> incoming;
    in property <bool> calling;
    callback answer(bool);
    callback cancel();
    callback dismiss();

    alignment: end;
    spacing: 10px;
    if root.incoming: Button {
        text: @tr("Decline");
        icon: Icons.phone-off;
        kind: ButtonKind.danger;
        clicked => { root.answer(false); }
    }
    if root.incoming: Button {
        text: @tr("Accept");
        icon: Icons.phone;
        kind: ButtonKind.primary;
        clicked => { root.answer(true); }
    }
    if !root.incoming && root.calling: Button {
        text: @tr("Cancel");
        icon: Icons.phone-off;
        kind: ButtonKind.danger;
        clicked => { root.cancel(); }
    }
    if !root.incoming && !root.calling: VerticalLayout {
        alignment: center;
        IconButton {
            icon: Icons.x;
            label: @tr("Dismiss");
            size: 36px;
            transparent: true;
            clicked => { root.dismiss(); }
        }
    }
}

// A call coming in, your ring going out, or how it ended: a card at the bottom, over whatever screen is up.
export component CallOverlay inherits Rectangle {
    // Who's calling; "" when nobody
    in property <string> incoming-from;
    // Whom you're calling; "" when nobody
    in property <string> calling;
    // They were offline when you rang: it rings only if they open the app in time
    in property <bool> calling-offline;
    // How your last ring ended (protocol's CallEndReason in kebab-case), and with whom; "" when nothing to say
    in property <string> notice;
    in property <string> notice-with;
    callback answer(bool);
    callback cancel();
    callback dismiss();

    property <string> notice-text: notice == "declined" ? @tr("{} declined", notice-with)
        : notice == "busy" ? @tr("{} is in another call. They'll see a missed call.", notice-with)
        : notice == "offline" ? @tr("{} isn't online. They'll see a missed call.", notice-with)
        : notice == "timeout" ? @tr("{} didn't answer", notice-with)
        : notice == "unavailable" ? @tr("Couldn't call {}", notice-with)
        : "";
    property <bool> showing: incoming-from != "" || calling != "" || notice-text != "";

    // What the card says, kept as it was while it goes
    property <string> shown-from;
    property <string> shown-calling;
    property <string> shown-notice;
    init => { keep(); }
    function keep() {
        if (showing) {
            shown-from = incoming-from;
            shown-calling = calling;
            shown-notice = notice-text;
        }
    }
    changed incoming-from => { keep(); }
    changed calling => { keep(); }
    changed notice-text => { keep(); }

    visible: card.opacity > 0;
    // Nothing in this rectangle but the card takes clicks
    width: card.width;
    height: card.height;

    // Hides the notice after a while, like the web's
    Timer {
        interval: 6s;
        running: root.incoming-from == "" && root.calling == "" && root.notice-text != "";
        triggered => { root.dismiss(); }
    }

    card := Rectangle {
        width: min(layout.preferred-width, root.parent-width - 32px);
        height: layout.preferred-height;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.glass-border;
        background: Theme.glass;
        drop-shadow-blur: 30px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: Theme.shadow;
        accessible-role: AccessibleRole.groupbox;
        // Rises in, and sinks back out still saying what it said
        y: root.showing ? 0 : 12px;
        opacity: root.showing ? 1 : 0;
        animate y, opacity { duration: Theme.med; easing: Theme.ease; }

        TouchArea { }

        layout := VerticalLayout {
            padding: 14px;
            padding-left: 18px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 14px;
                if root.shown-from != "" || root.shown-calling != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 22px;
                        background: Theme.accent-soft;
                        // Pulses while it rings, like the web's ring-pulse
                        transform-scale: Theme.reduced-motion || !root.showing ? 1
                            : 1.06 - 0.06 * Math.cos(animation-tick() / 1.4s * 360deg);
                        Image {
                            source: Icons.phone;
                            colorize: Theme.accent;
                            width: 22px;
                            height: 22px;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.shown-from != "" ? @tr("{} is calling", root.shown-from)
                            : root.shown-calling != "" ? @tr("Calling {}…", root.shown-calling)
                            : root.shown-notice;
                        color: Theme.text;
                        font-weight: root.shown-notice != "" && root.shown-from == "" && root.shown-calling == "" ? 400 : 650;
                        wrap: word-wrap;
                    }
                    if root.shown-from == "" && root.shown-calling != "" && root.calling-offline: Text {
                        text: @tr("Offline: it rings if they open the app in time.");
                        color: Theme.muted;
                        font-size: Theme.font-size-small;
                        wrap: word-wrap;
                    }
                }
                if !root.narrow || (root.shown-from == "" && root.shown-calling == ""): Buttons {
                    incoming: root.shown-from != "";
                    calling: root.shown-calling != "";
                    answer(accept) => { root.answer(accept); }
                    cancel => { root.cancel(); }
                    dismiss => { root.dismiss(); }
                }
            }
            if root.narrow && (root.shown-from != "" || root.shown-calling != ""): Buttons {
                incoming: root.shown-from != "";
                calling: root.shown-calling != "";
                answer(accept) => { root.answer(accept); }
                cancel => { root.cancel(); }
                dismiss => { root.dismiss(); }
            }
        }
    }

    // A phone held upright: the buttons go under the text
    property <bool> narrow: root.parent-width < 520px;

    // The window's width, for the card's limit
    in property <length> parent-width;
}
