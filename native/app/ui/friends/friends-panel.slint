import { Theme } from "../theme.slint";
import { Icons } from "../components/icons.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { IconButton, IconButtonKind } from "../components/icon-button.slint";
import { Field } from "../components/field.slint";
import { AccountText } from "../account/errors.slint";
import { FriendMenu } from "friend-menu.slint";

// presence: "online", "away", "in-call" or "offline"; missed: how many calls from them you missed, the latest at missed-at
// came-online: was offline or in a call on the last list
export struct FriendRow { name: string, presence: string, missed: int, missed-at: string, came-online: bool }
export struct RoomRow { room-id: string, with: string }

// Turns while it's shown; stands still under reduced motion
component Spinner inherits Rectangle {
    width: 14px;
    height: 14px;
    Image {
        width: 100%;
        height: 100%;
        source: Icons.loader-circle;
        colorize: Theme.muted;
        transform-rotation: Theme.reduced-motion ? 0deg : Math.mod(animation-tick() / 1ms, 900) / 900 * 360deg;
    }
}

component Card inherits Rectangle {
    in property <string> title;
    // A spinner beside the title
    in property <bool> busy;
    in property <string> busy-label;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    VerticalLayout {
        padding: 14px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 2px;
        if root.title != "": HorizontalLayout {
            alignment: start;
            spacing: 8px;
            Text {
                text: root.title;
                color: Theme.muted;
                font-size: Theme.font-size-small;
                font-weight: 650;
            }
            if root.busy: VerticalLayout {
                alignment: center;
                Spinner {
                    accessible-role: progress-indicator;
                    accessible-label: root.busy-label;
                }
            }
        }
        @children
    }
}

// Fades in as it comes into the list; a row the re-sort moves comes back in this way at its new place
component FadeIn inherits VerticalLayout {
    property <bool> shown;
    opacity: shown ? 1 : 0;
    animate opacity { duration: Theme.med; easing: Theme.ease; }
    // A tick after the first frame: set in init, there would be nothing to animate from
    Timer {
        interval: 1ms;
        triggered => {
            self.running = false;
            root.shown = true;
        }
    }
    @children
}

// A name on the left, controls on the right
component Row inherits HorizontalLayout {
    in property <string> name;
    in property <string> detail;
    in property <color> dot: #00000000;
    // Only the dot's outline: their app is open in the background
    in property <bool> dot-hollow;
    // Rings the dot out once: a friend just came online
    in property <bool> ping;
    property <bool> pinging;
    property <duration> ping-at;
    init => { if (ping) { start-ping(); } }
    changed ping => { if (ping) { start-ping(); } }
    min-height: 52px;
    spacing: 10px;
    if root.dot != #00000000: VerticalLayout {
        alignment: center;
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: root.dot-hollow ? transparent : root.dot;
            border-width: root.dot-hollow ? 2px : 0;
            border-color: root.dot;
            if root.pinging: Rectangle {
                property <float> t: min(1, (animation-tick() - root.ping-at) / Theme.slow);
                border-radius: self.width / 2;
                background: root.dot;
                opacity: 0.6 * (1 - t);
                transform-scale: 1 + 1.6 * t;
            }
            Timer {
                interval: Theme.slow;
                running: root.pinging;
                triggered => { root.pinging = false; }
            }
        }
    }
    HorizontalLayout {
        horizontal-stretch: 1;
        spacing: 10px;
        Text {
            text: root.name;
            color: Theme.text;
            font-weight: 550;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.detail;
            color: Theme.muted;
            font-size: Theme.font-size-small;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
    @children

    function start-ping() {
        if (!Theme.reduced-motion) {
            ping-at = animation-tick();
            pinging = true;
        }
    }
}

// A friend row's shape, pulsing until the first list comes in
component SkeletonRow inherits HorizontalLayout {
    in property <length> name-width;
    min-height: 52px;
    spacing: 10px;
    opacity: Theme.reduced-motion ? 1 : 0.7 + 0.3 * Math.cos(animation-tick() / 1s * 4.5rad);
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: Theme.surface-3;
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        HorizontalLayout {
            alignment: start;
            Rectangle {
                width: root.name-width;
                height: 14px;
                border-radius: 7px;
                background: Theme.surface-3;
            }
        }
    }
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: Theme.surface-3;
        }
    }
}

// The signed-in start screen's friends: rooms to rejoin, requests, friends with presence and missed calls (sorted by
// the bridge), and adding one.
export component FriendsPanel inherits VerticalLayout {
    in property <[FriendRow]> friends;
    in property <[string]> incoming;
    in property <[string]> outgoing;
    in property <[RoomRow]> rooms;
    in property <bool> connected;
    // The first list came in; until then the friends are skeletons
    in property <bool> loaded;
    // Your ring is going out: no second one meanwhile
    in property <bool> calling;
    in property <string> error;
    callback ring(string);
    callback friend-action(string, string);
    // Clears the missed calls from this friend
    callback missed-seen(string);
    // A bottom sheet for ⋯ instead of a popover, and the screen its popup covers
    in property <bool> sheet;
    in property <length> area-x;
    in property <length> area-y;
    in property <length> area-width;
    in property <length> area-height;
    callback rejoin(string);
    callback clear-error();

    property <bool> sent;

    spacing: 14px;

    if root.rooms.length > 0: Card {
        title: @tr("Rooms");
        for room in root.rooms: FadeIn {
            Row {
                name: @tr("{} is still in the call", room.with);
                Button {
                    text: @tr("Rejoin");
                    kind: ButtonKind.primary;
                    height-hint: 38px;
                    clicked => { root.rejoin(room.room-id); }
                }
            }
        }
    }

    if root.incoming.length > 0: Card {
        title: @tr("Friend requests");
        for name in root.incoming: FadeIn {
            Row {
                name: name;
                Button {
                    text: @tr("Accept");
                    kind: ButtonKind.primary;
                    height-hint: 38px;
                    clicked => { root.friend-action("accept", name); }
                }
                Button {
                    text: @tr("Decline");
                    height-hint: 38px;
                    clicked => { root.friend-action("remove", name); }
                }
            }
        }
    }

    Card {
        title: @tr("Friends");
        // The list stays as it was meanwhile
        busy: root.loaded && !root.connected;
        busy-label: @tr("Reconnecting…");
        if !root.loaded: VerticalLayout {
            accessible-role: none;
            SkeletonRow { name-width: 140px; }
            SkeletonRow { name-width: 96px; }
            SkeletonRow { name-width: 120px; }
        }
        if root.loaded && root.friends.length == 0: Text {
            text: @tr("No friends yet. Add someone by their exact username.");
            color: Theme.muted;
            font-size: Theme.font-size-small;
            wrap: word-wrap;
        }
        for friend in root.friends: FadeIn {
            Row {
                name: friend.name;
                detail: friend.presence == "online" ? @tr("Online") : friend.presence == "away" ? @tr("Away")
                    : friend.presence == "in-call" ? @tr("In a call") : @tr("Offline");
                dot: friend.presence == "online" || friend.presence == "away" ? Theme.good
                    : friend.presence == "in-call" ? Theme.ok : Theme.surface-3;
                dot-hollow: friend.presence == "away";
                ping: friend.came-online;
                VerticalLayout {
                    alignment: center;
                    FriendMenu {
                        name: friend.name;
                        sheet: root.sheet;
                        area-x: root.area-x;
                        area-y: root.area-y;
                        area-width: root.area-width;
                        area-height: root.area-height;
                        act(action) => { root.friend-action(action, friend.name); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.phone;
                        label: @tr("Call {}", friend.name);
                        kind: IconButtonKind.active;
                        size: 40px;
                        enabled: !root.calling && root.connected;
                        clicked => { root.ring(friend.name); }
                    }
                }
            }
            // Under the name, past the presence dot
            if friend.missed > 0: HorizontalLayout {
                padding-left: 20px;
                padding-bottom: 6px;
                spacing: 2px;
                alignment: start;
                Text {
                    text: friend.missed > 1 ? @tr("{} missed calls · {}", friend.missed, friend.missed-at)
                        : @tr("Missed call · {}", friend.missed-at);
                    color: Theme.bad;
                    font-size: Theme.font-size-small;
                    font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                }
                IconButton {
                    icon: Icons.x;
                    label: @tr("Clear missed calls from {}", friend.name);
                    size: 24px;
                    transparent: true;
                    clicked => { root.missed-seen(friend.name); }
                }
            }
        }
        for name in root.outgoing: FadeIn {
            Row {
                name: name;
                detail: @tr("Waiting for them to accept");
                Button {
                    text: @tr("Withdraw");
                    height-hint: 36px;
                    font-size: Theme.font-size-small;
                    clicked => { root.friend-action("remove", name); }
                }
            }
        }

        HorizontalLayout {
            padding-top: 10px;
            spacing: 8px;
            add := Field {
                horizontal-stretch: 1;
                placeholder: @tr("Add a friend by username");
                edited => {
                    root.sent = false;
                    root.clear-error();
                }
                accepted => { root.add-friend(); }
            }
            VerticalLayout {
                alignment: end;
                Button {
                    text: @tr("Send");
                    icon: Icons.user-plus;
                    enabled: add.text != "";
                    clicked => { root.add-friend(); }
                }
            }
        }
        if root.sent && root.error == "": Text {
            text: @tr("If that username exists, they'll see your request.");
            color: Theme.muted;
            font-size: Theme.font-size-small;
            wrap: word-wrap;
        }
        if root.error != "": Text {
            text: AccountText.error(root.error);
            color: Theme.bad;
            font-size: Theme.font-size-small;
            wrap: word-wrap;
        }
    }

    function add-friend() {
        if (add.text == "") { return; }
        root.friend-action("request", add.text);
        add.clear();
        root.sent = true;
    }
}
