import { Theme } from "../theme.slint";
import { Icons } from "../components/icons.slint";
import { IconButton } from "../components/icon-button.slint";
import { AccountSection } from "../account/account-section.slint";
import { Group, PageRow, Divider } from "rows.slint";
import { AudioPage } from "audio-page.slint";
import { VideoPage } from "video-page.slint";
import { SpeechPage, ModelState } from "speech-page.slint";
import { DebugPage } from "debug-page.slint";

export { ModelState }

// The app's settings over whatever screen is up, like the web's SettingsSheet: from the bottom on a phone or a
// narrow window, from the right as a side panel otherwise. The first page lists the pages; Back or Esc goes up from
// one, and a tap on the dim, or Esc or Back on the first page, close it.
export component SettingsSheet inherits Rectangle {
    // From the bottom instead of the right
    in property <bool> sheet;
    in property <bool> show-stats;
    in property <bool> record-stats;
    in property <bool> can-show-files;
    in property <bool> fec;
    in property <bool> sharpen-video;
    in property <bool> compare-upscaling;
    in property <int> frame-saved;
    in property <bool> subtitles-on;
    in property <bool> noise-suppression;
    // "auto", "h264" or "vp8"
    in property <string> video-codec;
    // "balanced", "high" or "custom", and Custom's ceiling in Mbps
    in property <string> screen-quality;
    in property <int> screen-mbps;
    // "modern" or "opengl"; empty hides the choice
    in property <string> renderer;
    in property <string> lang;
    in property <ModelState> model-state;
    in property <int> model-progress;
    in property <string> model-size;
    in property <bool> on-device;
    in property <ModelState> translation-state;
    in property <int> translation-progress;
    in property <string> translation-size;
    // The account part, while signed in
    in property <string> username;
    in property <string> account-error;
    in property <bool> account-busy;
    in property <string> invite;
    in property <int> invites-unused;
    in property <int> invites-max;
    in property <bool> password-changed;
    in property <[string]> blocked;
    callback new-invite();
    callback change-password(string, string);
    callback unblock(string);
    callback sign-out();
    callback delete-account(string);
    callback clear-account-error();
    callback set-show-stats(bool);
    callback set-record-stats(bool);
    callback show-stats-files();
    callback set-fec(bool);
    callback set-sharpen-video(bool);
    callback set-compare-upscaling(bool);
    callback save-frame();
    callback set-subtitles-on(bool);
    callback set-noise-suppression(bool);
    callback set-video-codec(string);
    callback set-screen-quality(string);
    // +1 or -1 Mbps
    callback step-screen-mbps(int);
    callback set-renderer(string);
    callback set-lang(string);
    callback download-model();
    callback cancel-download();
    callback delete-model();
    callback set-on-device(bool);
    callback download-translation();
    callback delete-translation();
    // The panel is gone: the owner removes it
    callback closed();

    // The open page: "audio", "video", "speech", "account" or "debug", or empty for the first page
    property <string> page;
    // Going back: the page comes in from the left
    property <bool> back;
    // A page is coming in: at its start offset for one tick, then it slides into place
    property <bool> entering;
    property <bool> shown;
    property <bool> closing;
    init => { keys.focus(); }
    // Opens a tick after the first frame: set in init, there would be nothing to animate from
    enter-timer := Timer {
        interval: 1ms;
        triggered => {
            self.running = false;
            root.shown = true;
        }
    }

    // Slides the panel away, then closes
    public function dismiss() {
        if (closing) {
            return;
        }
        closing = true;
        shown = false;
        exit-timer.running = true;
    }

    function go(next: string) {
        back = next == "";
        page = next;
        entering = true;
        flick.content-y = 0;
        page-timer.running = true;
    }

    exit-timer := Timer {
        interval: Theme.sheet;
        running: false;
        triggered => {
            self.running = false;
            root.closed();
        }
    }

    page-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.entering = false;
        }
    }

    keys := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == Key.Back) {
                if (root.page != "") {
                    root.go("");
                } else {
                    root.dismiss();
                }
                return accept;
            }
            reject
        }
    }

    Rectangle {
        background: Theme.sheet-dim;
        opacity: root.shown ? 1 : 0;
        animate opacity { duration: Theme.sheet; easing: Theme.ease-sheet; }
        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.dismiss();
                }
            }
        }
    }

    panel := Rectangle {
        width: root.sheet ? min(root.width, 520px) : min(root.width, 380px);
        // Tall enough for everything, up to most of the window; the rows scroll past that
        height: root.sheet ? min(column.preferred-height, root.height * 0.9) : root.height;
        x: root.sheet ? (root.width - self.width) / 2 : root.shown ? root.width - self.width : root.width;
        y: !root.sheet ? 0 : root.shown ? root.height - self.height : root.height;
        animate x, y { duration: Theme.sheet; easing: Theme.ease-sheet; }
        border-radius: 0;
        border-top-left-radius: Theme.radius-lg;
        border-top-right-radius: root.sheet ? Theme.radius-lg : 0;
        border-bottom-left-radius: root.sheet ? 0 : Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.glass-border;
        background: Theme.surface;
        drop-shadow-blur: 30px;
        drop-shadow-color: Theme.shadow;
        accessible-role: AccessibleRole.groupbox;
        accessible-label: @tr("Settings");

        // Under the sheet's bottom edge, so its spring shows no gap
        if root.sheet: Rectangle {
            y: parent.height - 1px;
            height: 80px;
            background: Theme.surface;
        }

        // Swallows presses that miss a control, so they don't reach the dim
        TouchArea { }

        column := VerticalLayout {
            HorizontalLayout {
                padding: 16px;
                padding-left: root.page == "" ? 16px : 8px;
                padding-bottom: 8px;
                spacing: 4px;
                if root.page != "": IconButton {
                    icon: Icons.chevron-left;
                    label: @tr("Back");
                    size: 36px;
                    transparent: true;
                    clicked => { root.go(""); }
                }
                Text {
                    text: root.page == "audio" ? @tr("Audio")
                        : root.page == "video" ? @tr("Video")
                        : root.page == "speech" ? @tr("Speech")
                        : root.page == "account" ? @tr("Account")
                        : root.page == "debug" ? @tr("Debug")
                        : @tr("Settings");
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 650;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: Icons.x;
                    label: @tr("Close");
                    size: 36px;
                    transparent: true;
                    clicked => { root.dismiss(); }
                }
            }

            flick := Flickable {
                preferred-height: content.preferred-height;
                content-height: content.preferred-height;
                vertical-stretch: 1;

                content := VerticalLayout {
                    width: parent.width;
                    alignment: start;
                    padding: 16px;
                    padding-top: 8px;

                    if root.page == "": Group {
                        PageRow {
                            icon: Icons.mic;
                            title: @tr("Audio");
                            detail: @tr("Noise suppression: {}", root.noise-suppression ? @tr("On") : @tr("Off"));
                            clicked => { root.go("audio"); }
                        }
                        Divider { }
                        PageRow {
                            icon: Icons.video;
                            title: @tr("Video");
                            detail: @tr("Video codec: {}", root.video-codec == "h264" ? "H.264" : root.video-codec == "vp8" ? "VP8" : @tr("Auto"));
                            clicked => { root.go("video"); }
                        }
                        Divider { }
                        PageRow {
                            icon: Icons.languages;
                            title: @tr("Speech");
                            detail: (root.lang == "zh" ? "中文" : "English") + " · " + @tr("Live subtitles: {}", root.subtitles-on ? @tr("On") : @tr("Off"));
                            clicked => { root.go("speech"); }
                        }
                        if root.username != "": Divider { }
                        if root.username != "": PageRow {
                            icon: Icons.user-round;
                            title: @tr("Account");
                            detail: root.username;
                            clicked => { root.go("account"); }
                        }
                        Divider { }
                        PageRow {
                            icon: Icons.activity;
                            title: @tr("Debug");
                            detail: @tr("Connection stats: {}", root.show-stats ? @tr("On") : @tr("Off"));
                            clicked => { root.go("debug"); }
                        }
                    }

                    if root.page == "audio": AudioPage {
                        noise-suppression: root.noise-suppression;
                        set-noise-suppression(on) => { root.set-noise-suppression(on); }
                    }

                    if root.page == "video": VideoPage {
                        video-codec: root.video-codec;
                        screen-quality: root.screen-quality;
                        screen-mbps: root.screen-mbps;
                        renderer: root.renderer;
                        sharpen-video: root.sharpen-video;
                        set-video-codec(codec) => { root.set-video-codec(codec); }
                        set-screen-quality(quality) => { root.set-screen-quality(quality); }
                        step-screen-mbps(step) => { root.step-screen-mbps(step); }
                        set-renderer(renderer) => { root.set-renderer(renderer); }
                        set-sharpen-video(on) => { root.set-sharpen-video(on); }
                    }

                    if root.page == "speech": SpeechPage {
                        lang: root.lang;
                        subtitles-on: root.subtitles-on;
                        translation-state: root.translation-state;
                        translation-progress: root.translation-progress;
                        translation-size: root.translation-size;
                        model-state: root.model-state;
                        model-progress: root.model-progress;
                        model-size: root.model-size;
                        on-device: root.on-device;
                        set-lang(lang) => { root.set-lang(lang); }
                        set-subtitles-on(on) => { root.set-subtitles-on(on); }
                        download-translation => { root.download-translation(); }
                        delete-translation => { root.delete-translation(); }
                        download-model => { root.download-model(); }
                        cancel-download => { root.cancel-download(); }
                        delete-model => { root.delete-model(); }
                        set-on-device(on) => { root.set-on-device(on); }
                    }

                    if root.page == "account": AccountSection {
                        username: root.username;
                        error: root.account-error;
                        busy: root.account-busy;
                        invite: root.invite;
                        invites-unused: root.invites-unused;
                        invites-max: root.invites-max;
                        password-changed: root.password-changed;
                        blocked: root.blocked;
                        new-invite => { root.new-invite(); }
                        change-password(current, next) => { root.change-password(current, next); }
                        unblock(name) => { root.unblock(name); }
                        sign-out => {
                            root.sign-out();
                            root.dismiss();
                        }
                        delete-account(password) => { root.delete-account(password); }
                        clear-error => { root.clear-account-error(); }
                    }

                    if root.page == "debug": DebugPage {
                        show-stats: root.show-stats;
                        record-stats: root.record-stats;
                        can-show-files: root.can-show-files;
                        fec: root.fec;
                        can-upscale: root.renderer == "modern";
                        compare-upscaling: root.compare-upscaling;
                        frame-saved: root.frame-saved;
                        set-show-stats(on) => { root.set-show-stats(on); }
                        set-record-stats(on) => { root.set-record-stats(on); }
                        show-stats-files => { root.show-stats-files(); }
                        set-fec(on) => { root.set-fec(on); }
                        set-compare-upscaling(on) => { root.set-compare-upscaling(on); }
                        save-frame => { root.save-frame(); }
                    }
                }

                states [
                    entering when root.entering: {
                        content.x: root.back ? -32px : 32px;
                        content.opacity: 0;
                        out {
                            animate content.x, content.opacity { duration: Theme.med; easing: Theme.ease; }
                        }
                    }
                ]
            }
        }
    }
}
