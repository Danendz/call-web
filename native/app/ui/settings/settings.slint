import { Theme } from "../theme.slint";
import { Icons } from "../components/icons.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { IconButton } from "../components/icon-button.slint";
import { LangSwitch } from "../setup/lang-switch.slint";

// Where the on-device speech model stands, as the engine's ModelStatus
export enum ModelState { missing, downloading, ready, failed }

// An on/off switch, like the OS's own
component Switch inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();

    width: 44px;
    height: 26px;
    border-radius: self.height / 2;
    background: checked ? Theme.accent : Theme.surface-3;
    opacity: enabled ? 1 : 0.38;
    animate background { duration: Theme.fast; easing: Theme.ease; }
    accessible-role: switch;
    accessible-label: label;
    accessible-checked: checked;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { root.toggled(); } }

    Rectangle {
        width: parent.height - 6px;
        height: self.width;
        x: checked ? parent.width - self.width - 3px : 3px;
        border-radius: self.width / 2;
        background: #fff;
        animate x { duration: Theme.fast; easing: Theme.ease; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { if (root.enabled) { root.toggled(); } }
    }
}

// One row of a settings group: a title, a line under it, and a control at the end.
component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> detail;
    in property <color> detail-color: Theme.muted;

    padding: 16px;
    spacing: 14px;
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.font-size;
            wrap: word-wrap;
        }
        if root.detail != "": Text {
            text: root.detail;
            color: root.detail-color;
            font-size: Theme.font-size-small;
            wrap: word-wrap;
        }
    }
    @children
}

// A group of rows, like the OS's settings
component Group inherits Rectangle {
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface-2;
    VerticalLayout {
        @children
    }
}

// A section's heading over its group
component Heading inherits Text {
    color: Theme.muted;
    font-size: Theme.font-size-small;
    font-weight: 600;
}

// The app's settings over whatever screen is up, like the web's SettingsSheet: from the bottom on a phone or a
// narrow window, from the right as a side panel otherwise. A tap on the dim, Esc or Back close it.
export component SettingsSheet inherits Rectangle {
    // From the bottom instead of the right
    in property <bool> sheet;
    in property <bool> show-stats;
    in property <bool> noise-suppression;
    in property <string> lang;
    in property <ModelState> model-state;
    in property <int> model-progress;
    in property <string> model-size;
    in property <bool> on-device;
    callback set-show-stats(bool);
    callback set-noise-suppression(bool);
    callback set-lang(string);
    callback download-model();
    callback cancel-download();
    callback delete-model();
    callback set-on-device(bool);
    // The panel is gone: the owner removes it
    callback closed();

    property <bool> shown;
    property <bool> closing;
    init => { keys.focus(); }
    // Opens a tick after the first frame: set in init, there would be nothing to animate from
    enter-timer := Timer {
        interval: 1ms;
        triggered => {
            self.running = false;
            root.shown = true;
        }
    }

    // Slides the panel away, then closes
    public function dismiss() {
        if (closing) {
            return;
        }
        closing = true;
        shown = false;
        exit-timer.running = true;
    }

    exit-timer := Timer {
        interval: Theme.sheet;
        running: false;
        triggered => {
            self.running = false;
            root.closed();
        }
    }

    keys := FocusScope {
        width: 0;
        height: 0;
        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == Key.Back) {
                root.dismiss();
                return accept;
            }
            reject
        }
    }

    Rectangle {
        background: Theme.sheet-dim;
        opacity: root.shown ? 1 : 0;
        animate opacity { duration: Theme.sheet; easing: Theme.ease-sheet; }
        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.dismiss();
                }
            }
        }
    }

    panel := Rectangle {
        width: root.sheet ? min(root.width, 520px) : min(root.width, 380px);
        // Tall enough for everything, up to most of the window; the rows scroll past that
        height: root.sheet ? min(column.preferred-height, root.height * 0.9) : root.height;
        x: root.sheet ? (root.width - self.width) / 2 : root.shown ? root.width - self.width : root.width;
        y: !root.sheet ? 0 : root.shown ? root.height - self.height : root.height;
        animate x, y { duration: Theme.sheet; easing: Theme.ease-sheet; }
        border-radius: 0;
        border-top-left-radius: Theme.radius-lg;
        border-top-right-radius: root.sheet ? Theme.radius-lg : 0;
        border-bottom-left-radius: root.sheet ? 0 : Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.glass-border;
        background: Theme.surface;
        drop-shadow-blur: 30px;
        drop-shadow-color: Theme.shadow;
        accessible-role: AccessibleRole.groupbox;
        accessible-label: @tr("Settings");

        // Under the sheet's bottom edge, so its spring shows no gap
        if root.sheet: Rectangle {
            y: parent.height - 1px;
            height: 80px;
            background: Theme.surface;
        }

        // Swallows presses that miss a control, so they don't reach the dim
        TouchArea { }

        column := VerticalLayout {
            HorizontalLayout {
                padding: 16px;
                padding-bottom: 8px;
                spacing: 8px;
                Text {
                    text: @tr("Settings");
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 650;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: Icons.x;
                    label: @tr("Close");
                    size: 36px;
                    transparent: true;
                    clicked => { root.dismiss(); }
                }
            }

            Flickable {
                preferred-height: content.preferred-height;
                content-height: content.preferred-height;
                vertical-stretch: 1;

                content := VerticalLayout {
                    width: parent.width;
                    alignment: start;
                    padding: 16px;
                    padding-top: 8px;
                    spacing: 8px;

                    Group {
                        SettingRow {
                            title: @tr("Connection stats");
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    label: @tr("Connection stats");
                                    checked: root.show-stats;
                                    toggled => { root.set-show-stats(!root.show-stats); }
                                }
                            }
                        }
                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }
                        SettingRow {
                            title: @tr("Noise suppression");
                            detail: @tr("May slow down games or other heavy apps while you share your screen.");
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    label: @tr("Noise suppression");
                                    checked: root.noise-suppression;
                                    toggled => { root.set-noise-suppression(!root.noise-suppression); }
                                }
                            }
                        }
                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }
                        SettingRow {
                            title: @tr("I speak");
                            VerticalLayout {
                                alignment: center;
                                LangSwitch {
                                    lang: root.lang;
                                    picked(lang) => { root.set-lang(lang); }
                                }
                            }
                        }
                    }

                    Rectangle { height: 10px; }
                    Heading { text: @tr("Speech to chat"); }

                    Group {
                        SettingRow {
                            title: @tr("On-device recognition");
                            detail: root.model-state == ModelState.ready ? @tr("Downloaded · {}", root.model-size)
                                : root.model-state == ModelState.downloading ? @tr("Downloading… {}%", root.model-progress)
                                : root.model-state == ModelState.failed ? @tr("The download stopped. Try again to continue where it left off.")
                                : @tr("Not downloaded · {}", root.model-size);
                            detail-color: root.model-state == ModelState.failed ? Theme.danger-text : Theme.muted;
                            VerticalLayout {
                                alignment: center;
                                if root.model-state == ModelState.missing: Button {
                                    text: @tr("Download");
                                    icon: Icons.download;
                                    kind: ButtonKind.primary;
                                    height-hint: 38px;
                                    clicked => { root.download-model(); }
                                }
                                if root.model-state == ModelState.failed: Button {
                                    text: @tr("Try again");
                                    kind: ButtonKind.primary;
                                    height-hint: 38px;
                                    clicked => { root.download-model(); }
                                }
                                if root.model-state == ModelState.downloading: Button {
                                    text: @tr("Cancel");
                                    height-hint: 38px;
                                    clicked => { root.cancel-download(); }
                                }
                                if root.model-state == ModelState.ready: Button {
                                    text: @tr("Delete");
                                    kind: ButtonKind.danger;
                                    height-hint: 38px;
                                    clicked => { root.delete-model(); }
                                }
                            }
                        }

                        if root.model-state == ModelState.downloading: VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-bottom: 16px;
                            Rectangle {
                                height: 4px;
                                border-radius: 2px;
                                background: Theme.surface-3;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * root.model-progress / 100;
                                    border-radius: 2px;
                                    background: Theme.accent;
                                    animate width { duration: Theme.med; easing: Theme.ease; }
                                }
                            }
                        }

                        if root.model-state == ModelState.ready: Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }
                        if root.model-state == ModelState.ready: SettingRow {
                            title: @tr("Recognize on this device");
                            detail: root.on-device ? "" : @tr("Speech goes to the server");
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    label: @tr("Recognize on this device");
                                    checked: root.on-device;
                                    toggled => { root.set-on-device(!root.on-device); }
                                }
                            }
                        }
                    }

                    Text {
                        text: @tr("Recognizing speech on this device turns it into chat faster, keeps working when the server's speech limit is used up, and your voice never leaves the device.");
                        color: Theme.muted;
                        font-size: Theme.font-size-small;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
