import { Theme } from "../theme.slint";
import { Icons } from "../components/icons.slint";
import { IconButton } from "../components/icon-button.slint";
import { Segmented } from "../components/segmented.slint";
import { Switch, SettingRow, Group, Shown, Divider } from "rows.slint";

// Settings' Video page: codec, screen share quality, and on desktop the graphics and sharpening
export component VideoPage inherits VerticalLayout {
    // "auto", "h264" or "vp8"
    in property <string> video-codec;
    // "balanced", "high" or "custom", and Custom's ceiling in Mbps
    in property <string> screen-quality;
    in property <int> screen-mbps;
    // "modern" or "opengl"; empty hides the choice
    in property <string> renderer;
    in property <bool> sharpen-video;
    callback set-video-codec(string);
    callback set-screen-quality(string);
    // +1 or -1 Mbps
    callback step-screen-mbps(int);
    callback set-renderer(string);
    callback set-sharpen-video(bool);

    Group {
        // Three options don't fit beside the text, so they go under it
        VerticalLayout {
            SettingRow {
                padding-bottom: 0;
                title: @tr("Video codec");
                detail: @tr("If video freezes or breaks up, VP8 switches the whole call to it, for both of you.");
            }
            HorizontalLayout {
                padding: 16px;
                padding-top: 12px;
                alignment: start;
                Segmented {
                    options: [
                        { id: "auto", name: @tr("Auto") },
                        { id: "h264", name: "H.264" },
                        { id: "vp8", name: "VP8" },
                    ];
                    value: root.video-codec;
                    picked(id) => { root.set-video-codec(id); }
                }
            }
        }
        Divider { }
        VerticalLayout {
            SettingRow {
                padding-bottom: 0;
                title: @tr("Screen share quality");
                detail: @tr("The most your shared screen may use. A slower connection still gets less.");
            }
            HorizontalLayout {
                padding: 16px;
                padding-top: 12px;
                spacing: 12px;
                alignment: start;
                Segmented {
                    options: [
                        { id: "balanced", name: @tr("Balanced") },
                        { id: "high", name: @tr("High") },
                        { id: "custom", name: @tr("Custom") },
                    ];
                    value: root.screen-quality;
                    picked(id) => { root.set-screen-quality(id); }
                }
                if root.screen-quality == "custom": HorizontalLayout {
                    alignment: start;
                    spacing: 4px;
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        size: 32px;
                        transparent: true;
                        icon: Icons.chevron-left;
                        label: @tr("Less");
                        enabled: root.screen-mbps > 1;
                        clicked => { root.step-screen-mbps(-1); }
                    }
                    Text {
                        min-width: 64px;
                        text: @tr("{} Mbps", root.screen-mbps);
                        color: Theme.text;
                        font-size: Theme.font-size-small;
                        font-weight: 550;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        size: 32px;
                        transparent: true;
                        icon: Icons.chevron-right;
                        label: @tr("More");
                        enabled: root.screen-mbps < 30;
                        clicked => { root.step-screen-mbps(1); }
                    }
                }
            }
        }
        // Desktop only: a phone always draws with OpenGL
        Shown {
            shown: root.renderer != "";
            Divider { }
            SettingRow {
                title: @tr("Graphics");
                detail: @tr("Applies after restart.");
                VerticalLayout {
                    alignment: center;
                    Segmented {
                        value: root.renderer;
                        options: [{ id: "modern", name: @tr("Modern") }, { id: "opengl", name: "OpenGL" }];
                        picked(renderer) => { root.set-renderer(renderer); }
                    }
                }
            }
            // Upscaling runs on the GPU path, which a phone doesn't have
            Divider { }
            SettingRow {
                title: @tr("Sharpen video");
                detail: root.renderer == "opengl" ? @tr("Only with Modern graphics.")
                    : @tr("Sharper when their video comes in smaller than it shows here.");
                VerticalLayout {
                    alignment: center;
                    Switch {
                        label: @tr("Sharpen video");
                        checked: root.sharpen-video;
                        toggled => { root.set-sharpen-video(!root.sharpen-video); }
                    }
                }
            }
        }
    }
}
