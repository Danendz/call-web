import { Segmented } from "../components/segmented.slint";

// "I speak": each language under its own name, so it reads the same in either UI language.
export component LangSwitch inherits Segmented {
    in property <string> lang;
    value: root.lang;
    options: [{ id: "zh", name: "中文" }, { id: "en", name: "English" }];
}
