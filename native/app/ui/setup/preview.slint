import { Theme } from "../theme.slint";
import { Icons } from "../components/icons.slint";
import { IconButton, IconButtonKind } from "../components/icon-button.slint";

// The camera preview with the mic and camera toggles over it, like the web's `.preview`.
export component Preview inherits Rectangle {
    in property <bool> mic-on;
    in property <bool> has-mic;
    // 0..=1, drawn as a ring around the mic button so you can see the right mic is picked up before joining
    in property <float> mic-level;
    in property <image> video;
    in property <bool> cam-on;
    in property <bool> cam-granted;
    // Why there's no picture when the camera can't be used, e.g. "Camera: Not found"
    in property <string> cam-status;
    in property <bool> portrait;
    callback toggle-mic();
    callback toggle-cam();
    callback toggle-portrait();

    property <bool> showing: cam-granted && cam-on && video.width > 0;

    border-radius: Theme.radius-lg;
    background: Theme.surface;
    drop-shadow-blur: 30px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: Theme.shadow;
    clip: true;

    Image {
        width: 100%;
        height: 100%;
        source: video;
        image-fit: cover;
        opacity: showing ? 1 : 0;
        animate opacity { duration: Theme.med; easing: Theme.ease; }
    }

    if !showing: VerticalLayout {
        alignment: center;
        spacing: 10px;
        padding: 16px;
        padding-bottom: 80px;
        HorizontalLayout {
            alignment: center;
            Image {
                source: Icons.video-off;
                colorize: Theme.muted;
                width: 28px;
                height: 28px;
            }
        }
        Text {
            text: cam-status != "" ? cam-status : cam-granted && !cam-on ? @tr("Camera is off") : "";
            color: Theme.muted;
            font-size: Theme.font-size-small;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 14px;
        width: controls.preferred-width;
        height: controls.preferred-height;
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: Theme.glass-border;
        background: Theme.glass;

        controls := HorizontalLayout {
            padding: 6px;
            spacing: 10px;

            Rectangle {
                width: mic.width;
                height: mic.height;
                // The web's box-shadow ring: grows up to 6px with the level
                property <length> ring: has-mic && mic-on ? mic-level * 6px : 0;
                // A border, not a fill: the button is see-through and the web's shadow only shows outside it
                Rectangle {
                    width: parent.width + 2 * ring;
                    height: parent.height + 2 * ring;
                    border-radius: self.height / 2;
                    border-width: ring;
                    border-color: Theme.level;
                }
                mic := IconButton {
                    size: 46px;
                    icon: mic-on && has-mic ? Icons.mic : Icons.mic-off;
                    label: mic-on ? @tr("Turn off microphone") : @tr("Turn on microphone");
                    kind: has-mic && !mic-on ? IconButtonKind.off : IconButtonKind.normal;
                    enabled: has-mic;
                    clicked => { root.toggle-mic(); }
                }
            }
            IconButton {
                size: 46px;
                icon: cam-on && cam-granted ? Icons.video : Icons.video-off;
                label: cam-on ? @tr("Turn off camera") : @tr("Turn on camera");
                kind: cam-granted && !cam-on ? IconButtonKind.off : IconButtonKind.normal;
                enabled: cam-granted;
                clicked => { root.toggle-cam(); }
            }
            IconButton {
                size: 46px;
                icon: portrait ? Icons.rectangle-vertical : Icons.rectangle-horizontal;
                label: portrait ? @tr("Send landscape video") : @tr("Send portrait video");
                enabled: cam-granted;
                clicked => { root.toggle-portrait(); }
            }
        }
    }
}
