import { Theme } from "../theme.slint";
import { Icons } from "../components/icons.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { LangSwitch } from "lang-switch.slint";
import { DeviceRow, DeviceItem } from "device-row.slint";
import { Preview } from "preview.slint";

// The column beside the preview: devices, language and the join button. The link to share shows once in the room.
component SetupPanel {
    in property <string> lang;
    in property <[DeviceItem]> mics;
    in property <string> mic-id;
    in property <string> mic-label;
    in property <[DeviceItem]> cams;
    in property <string> cam-id;
    in property <string> cam-label;
    in property <string> cam-status;
    in property <bool> cam-pending;
    in property <string> mic-status;
    callback set-lang(string);
    callback pick-mic(string);
    callback pick-cam(string);
    callback join();

    VerticalLayout {
        spacing: 18px;

        Text {
            text: @tr("Ready to join?");
            color: Theme.text;
            font-size: Theme.font-size-h1;
            font-weight: 650;
        }

        DeviceRow {
            icon: Icons.mic;
            name: @tr("Microphone");
            devices: root.mics;
            selected: root.mic-id;
            selected-label: root.mic-label;
            status: root.mic-status;
            picked(id) => { root.pick-mic(id); }
        }

        DeviceRow {
            icon: Icons.video;
            name: @tr("Camera");
            devices: root.cams;
            selected: root.cam-id;
            selected-label: root.cam-label;
            status: root.cam-status;
            pending: root.cam-pending;
            picked(id) => { root.pick-cam(id); }
        }

        Rectangle {
            height: 46px;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface-2;

            HorizontalLayout {
                padding-right: 5px;
                Rectangle {
                    width: 42px;
                    Image {
                        source: Icons.languages;
                        colorize: Theme.muted;
                        width: 18px;
                        height: 18px;
                    }
                }
                Text {
                    text: @tr("I speak");
                    color: Theme.muted;
                    font-size: Theme.font-size-small;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                LangSwitch {
                    y: (parent.height - self.height) / 2;
                    lang: root.lang;
                    picked(lang) => { root.set-lang(lang); }
                }
            }
        }

        Button {
            text: @tr("Join call");
            kind: ButtonKind.primary;
            height-hint: 52px;
            font-size: 16px;
            clicked => { root.join(); }
        }
    }
}

// Pre-join screen, like the web's Setup: preview and panel side by side, stacked when the window is narrow.
export component SetupScreen inherits Rectangle {
    in property <string> lang;
    in property <[DeviceItem]> mics;
    in property <string> mic-id;
    in property <string> mic-label;
    in property <bool> mic-on;
    in property <float> mic-level;
    in property <string> mic-status;
    in property <image> video;
    in property <int> video-rotation;
    in property <bool> cam-on;
    in property <bool> cam-granted;
    in property <bool> cam-pending;
    in property <[DeviceItem]> cams;
    in property <string> cam-id;
    in property <string> cam-label;
    in property <string> cam-status;
    in property <bool> portrait;
    callback set-lang(string);
    callback pick-mic(string);
    callback pick-cam(string);
    callback toggle-mic();
    callback toggle-cam();
    callback set-portrait(bool);
    callback join();
    callback back();
    property <bool> shown: false;
    property <bool> wide: root.width >= 1000px;
    property <length> panel-width: min(380px, root.width - 48px);
    init => { shown = true; }

    // Both arrangements hold the same two pieces; only one exists at a time
    if wide: HorizontalLayout {
        alignment: center;
        spacing: 40px;
        padding: 24px;
        opacity: shown ? 1 : 0;
        animate opacity { duration: Theme.slow; easing: Theme.ease; }

        VerticalLayout {
            alignment: center;
            Preview {
                // The web sizes the box from the frame's shape: min(640px, 64vh * ar) wide
                property <float> ar: root.portrait ? 9 / 16 : 16 / 9;
                width: min(min(640px, root.width - panel-width - 88px), root.height * 0.64 * ar);
                height: self.width / ar;
                animate width, height { duration: Theme.slow; easing: Theme.ease; }
                mic-on: root.mic-on;
                has-mic: root.mics.length > 0;
                mic-level: root.mic-level;
                video: root.video;
                video-rotation: root.video-rotation;
                cam-on: root.cam-on;
                cam-granted: root.cam-granted;
                cam-status: root.cam-status;
                portrait: root.portrait;
                toggle-mic => { root.toggle-mic(); }
                toggle-cam => { root.toggle-cam(); }
                toggle-portrait => { root.set-portrait(!root.portrait); }
            }
        }
        VerticalLayout {
            alignment: center;
            width: panel-width;
            SetupPanel {
                lang: root.lang;
                mics: root.mics;
                mic-id: root.mic-id;
                mic-label: root.mic-label;
                mic-status: root.mic-status;
                cams: root.cams;
                cam-id: root.cam-id;
                cam-label: root.cam-label;
                cam-status: root.cam-status;
                cam-pending: root.cam-pending;
                set-lang(lang) => { root.set-lang(lang); }
                pick-mic(id) => { root.pick-mic(id); }
                pick-cam(id) => { root.pick-cam(id); }
                join => { root.join(); }
            }
        }
    }

    if !wide: VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 24px;
        padding-top: 88px;
        padding-bottom: 16px;
        opacity: shown ? 1 : 0;
        animate opacity { duration: Theme.slow; easing: Theme.ease; }

        HorizontalLayout {
            alignment: center;
            Preview {
                // Whatever height the panel leaves, under the Back button's 88px and the layout's gaps
                property <float> ar: root.portrait ? 9 / 16 : 16 / 9;
                height: min((root.width - 48px) / ar, max(0px, root.height - 88px - 16px - 16px - panel.preferred-height));
                width: self.height * ar;
                visible: self.height > 120px;
                mic-on: root.mic-on;
                has-mic: root.mics.length > 0;
                mic-level: root.mic-level;
                video: root.video;
                video-rotation: root.video-rotation;
                cam-on: root.cam-on;
                cam-granted: root.cam-granted;
                cam-status: root.cam-status;
                portrait: root.portrait;
                toggle-mic => { root.toggle-mic(); }
                toggle-cam => { root.toggle-cam(); }
                toggle-portrait => { root.set-portrait(!root.portrait); }
            }
        }
        HorizontalLayout {
            alignment: center;
            panel := SetupPanel {
                width: panel-width;
                lang: root.lang;
                mics: root.mics;
                mic-id: root.mic-id;
                mic-label: root.mic-label;
                mic-status: root.mic-status;
                cams: root.cams;
                cam-id: root.cam-id;
                cam-label: root.cam-label;
                cam-status: root.cam-status;
                cam-pending: root.cam-pending;
                set-lang(lang) => { root.set-lang(lang); }
                pick-mic(id) => { root.pick-mic(id); }
                pick-cam(id) => { root.pick-cam(id); }
                join => { root.join(); }
            }
        }
    }

    // Back to new room / join by link. Below the macOS traffic lights, which sit over the content
    Button {
        x: 16px;
        y: 44px;
        width: self.preferred-width;
        height: 36px;
        text: @tr("Back");
        icon: Icons.arrow-left;
        height-hint: 36px;
        font-size: Theme.font-size-small;
        clicked => { root.back(); }
    }
}
