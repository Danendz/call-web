import { Theme } from "../theme.slint";
import { Icons } from "../components/icons.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { CopyLink } from "../components/copy-link.slint";
import { LangSwitch } from "lang-switch.slint";

// Pre-join screen. Camera preview and device pickers arrive with media (M1, M2).
export component SetupScreen inherits Rectangle {
    in property <string> room-url;
    in property <string> lang;
    callback set-lang(string);
    callback join();
    callback back();
    property <bool> shown: false;
    init => { shown = true; }

    HorizontalLayout {
        alignment: center;
        padding: 24px;
        opacity: shown ? 1 : 0;
        animate opacity { duration: Theme.slow; easing: Theme.ease; }

        VerticalLayout {
            alignment: center;
            spacing: 18px;
            width: min(380px, root.width - 48px);

            Text {
                text: @tr("Ready to join?");
                color: Theme.text;
                font-size: Theme.font-size-h1;
                font-weight: 650;
            }

            VerticalLayout {
                spacing: 8px;
                Text {
                    text: @tr("Share this link with the person you want to call");
                    color: Theme.muted;
                    font-size: Theme.font-size-small;
                    wrap: word-wrap;
                }
                CopyLink { url: root.room-url; }
            }

            Rectangle {
                height: 46px;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.surface-2;

                HorizontalLayout {
                    padding-right: 5px;
                    Rectangle {
                        width: 42px;
                        Image {
                            source: Icons.languages;
                            colorize: Theme.muted;
                            width: 18px;
                            height: 18px;
                        }
                    }
                    Text {
                        text: @tr("I speak");
                        color: Theme.muted;
                        font-size: Theme.font-size-small;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    LangSwitch {
                        y: (parent.height - self.height) / 2;
                        lang: root.lang;
                        picked(lang) => { root.set-lang(lang); }
                    }
                }
            }

            Button {
                text: @tr("Join call");
                kind: ButtonKind.primary;
                height-hint: 52px;
                font-size: 16px;
                clicked => { root.join(); }
            }
        }
    }

    // Back to new room / join by link. Below the macOS traffic lights, which sit over the content
    Button {
        x: 16px;
        y: 44px;
        width: self.preferred-width;
        height: 36px;
        text: @tr("Back");
        icon: Icons.arrow-left;
        height-hint: 36px;
        font-size: Theme.font-size-small;
        clicked => { root.back(); }
    }
}
