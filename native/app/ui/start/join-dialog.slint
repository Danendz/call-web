import { Theme } from "../theme.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { Dialog } from "../components/dialog.slint";
import { TextMenu } from "../components/text-menu.slint";

// Asks for a call link (or room id) over a dimmed backdrop. `submit` returns false when it isn't a room.
export component JoinDialog inherits Dialog {
    callback submit(string) -> bool;
    property <bool> invalid: false;
    init => { input.focus(); }

    card-width: 440px;
    // Puts the on-screen keyboard away
    card-clicked => { input.clear-focus(); }

    Text {
        text: @tr("Join by link");
        color: Theme.text;
        font-size: 20px;
        font-weight: 650;
    }

    Rectangle {
        height: 44px;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: invalid ? Theme.bad : input.has-focus ? Theme.accent : Theme.border;
        background: Theme.surface-2;
        animate border-color { duration: Theme.fast; easing: Theme.ease; }

        TextMenu {
            can-copy: input.text != "";
            cut => { input.cut(); }
            copy => { input.copy(); }
            paste => { input.paste(); }
            select-all => { input.select-all(); }

            input := TextInput {
                x: 14px;
                width: parent.width - 28px;
                single-line: true;
                color: Theme.text;
                font-size: Theme.font-size;
                vertical-alignment: center;
                accessible-label: @tr("Call link");
                edited => { invalid = false; }
                accepted => { go(); }
                key-pressed(event) => {
                    // Back on a phone, once the on-screen keyboard is away
                    if (event.text == Key.Escape || event.text == Key.Back) {
                        root.dismiss();
                        return accept;
                    }
                    reject
                }
            }
        }
        Text {
            x: 14px;
            text: "https://call.danendz.com/r/…";
            color: Theme.muted;
            font-size: Theme.font-size;
            vertical-alignment: center;
            height: parent.height;
            visible: input.text == "";
        }
    }

    if invalid: Text {
        text: @tr("That isn't a call link");
        color: Theme.bad;
        font-size: Theme.font-size-small;
    }

    HorizontalLayout {
        alignment: end;
        spacing: 10px;
        Button {
            text: @tr("Cancel");
            clicked => { root.dismiss(); }
        }
        Button {
            text: @tr("Join");
            kind: ButtonKind.primary;
            enabled: input.text != "";
            clicked => { go(); }
        }
    }

    function go() {
        if (!root.submit(input.text)) {
            invalid = true;
        }
    }
}
