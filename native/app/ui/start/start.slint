import { Theme } from "../theme.slint";
import { Icons } from "../components/icons.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { IconButton } from "../components/icon-button.slint";
import { JoinDialog } from "join-dialog.slint";
import { ModelState } from "../settings/settings.slint";
import { SpeechPrompt } from "speech-prompt.slint";

export { ModelState }

// First screen: a desktop app has no address bar, so the room comes from here.
export component StartScreen inherits Rectangle {
    in property <string> version;
    in property <string> update-version;
    // 0–100 while an update downloads, else -1
    in property <int> update-progress: -1;
    callback update-now();
    callback new-room();
    callback open-link(string) -> bool;
    // On a phone, until it's been read: "huawei" for its App launch page, "other" for battery settings elsewhere
    in property <string> background-guide;
    callback open-background-settings();
    callback dismiss-background-guide();
    in property <ModelState> model-state;
    in property <int> model-progress;
    in property <string> model-size;
    // Settings are open over this screen
    in property <bool> settings-open;
    callback open-settings();
    // The first launch's question about downloading the speech model
    in property <bool> speech-prompt;
    callback download-model();
    callback dismiss-speech-prompt();
    property <bool> asking: false;
    property <bool> shown: false;
    init => { shown = true; }

    VerticalLayout {
        alignment: center;
        spacing: 28px;
        padding: 24px;
        opacity: shown ? 1 : 0;
        y: shown ? 0 : 10px;
        animate opacity, y { duration: Theme.slow; easing: Theme.ease; }

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 72px;
                height: 72px;
                border-radius: self.width / 2;
                background: Theme.accent-soft;
                Image {
                    source: Icons.video;
                    colorize: Theme.accent;
                    width: 30px;
                    height: 30px;
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 10px;
            Button {
                text: @tr("New room");
                icon: Icons.plus;
                kind: ButtonKind.primary;
                height-hint: 52px;
                font-size: 16px;
                clicked => { root.new-room(); }
            }
            Button {
                text: @tr("Join by link");
                icon: Icons.link;
                height-hint: 52px;
                font-size: 16px;
                clicked => { asking = true; }
            }
        }

        // No API can change these settings, so the guide says where they are
        if root.background-guide != "": HorizontalLayout {
            alignment: center;
            Rectangle {
                width: min(440px, root.width - 48px);
                height: guide.preferred-height;
                border-radius: Theme.radius-lg;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.surface;
                guide := VerticalLayout {
                    padding: 18px;
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: 12px;
                        Image {
                            source: Icons.battery-warning;
                            colorize: Theme.accent;
                            width: 20px;
                            height: 20px;
                        }
                        Text {
                            text: root.background-guide == "huawei"
                                ? @tr("So calls keep going with the screen off: in Settings → Apps → App launch, set Call Danya to Manage manually and turn on all three switches.")
                                : @tr("So calls keep going with the screen off, let Call Danya run in the background without battery limits in its settings.");
                            color: Theme.text;
                            font-size: 14px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 10px;
                        Button {
                            text: @tr("Done");
                            height-hint: 40px;
                            clicked => { root.dismiss-background-guide(); }
                        }
                        Button {
                            text: @tr("Open settings");
                            kind: ButtonKind.primary;
                            height-hint: 40px;
                            clicked => { root.open-background-settings(); }
                        }
                    }
                }
            }
        }
    }

    // Only here, never in a call: updating restarts the app
    HorizontalLayout {
        y: parent.height - self.height - 16px;
        height: 36px;
        alignment: center;
        spacing: 12px;
        Text {
            text: "v" + root.version;
            color: Theme.muted;
            font-size: Theme.font-size-small;
            vertical-alignment: center;
        }
        if root.model-state == ModelState.downloading: Text {
            text: @tr("Downloading speech model… {}%", root.model-progress);
            color: Theme.muted;
            font-size: Theme.font-size-small;
            vertical-alignment: center;
        }
        if root.update-version == "" && root.update-progress >= 0: Text {
            text: @tr("Downloading update… {}%", root.update-progress);
            color: Theme.muted;
            font-size: Theme.font-size-small;
            vertical-alignment: center;
        }
        if root.update-version != "": Button {
            text: @tr("Update to {}", root.update-version);
            icon: Icons.rotate-cw;
            kind: ButtonKind.primary;
            height-hint: 36px;
            clicked => { root.update-now(); }
        }
    }

    IconButton {
        x: parent.width - self.width - 12px;
        y: 12px;
        icon: Icons.settings;
        label: @tr("Settings");
        transparent: true;
        clicked => { root.open-settings(); }
    }

    if asking: JoinDialog {
        submit(link) => { root.open-link(link) }
        close => { asking = false; }
    }

    if root.speech-prompt && !root.settings-open: SpeechPrompt {
        model-size: root.model-size;
        download => {
            root.download-model();
            root.dismiss-speech-prompt();
        }
        dismiss => { root.dismiss-speech-prompt(); }
    }
}
