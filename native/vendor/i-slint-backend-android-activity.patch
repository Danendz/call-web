+
+    /// Makes the renderer's surface for the native window with the API asked for. When that API isn't OpenGL and
+    /// can't start (a broken or missing Vulkan driver), falls back to OpenGL ES and keeps it for later surfaces,
+    /// instead of failing the event loop.
+    fn init_surface(&self) -> Result<(), PlatformError> {
+        use i_slint_core::graphics::{RequestedGraphicsAPI, RequestedOpenGLVersion};
+        let Some(w) = self.app.native_window() else { return Ok(()) };
+        let size = PhysicalSize { width: w.width() as u32, height: w.height() as u32 };
+        let requested = self.requested_graphics_api.borrow().clone();
+        let set = |api| {
+            self.renderer.set_window_handle(
+                Arc::new(w.clone()),
+                Arc::new(DummyDisplayHandle),
+                size,
+                api,
+                false,
+            )
+        };
+        match set(requested.clone()) {
+            Err(err)
+                if requested
+                    .as_ref()
+                    .is_some_and(|api| !matches!(api, RequestedGraphicsAPI::OpenGL(_))) =>
+            {
+                i_slint_core::debug_log!("Failed to initialize the requested renderer: {err}. Falling back to OpenGL ES");
+                let opengl = Some(RequestedGraphicsAPI::OpenGL(RequestedOpenGLVersion::OpenGLES(Some((3, 0)))));
+                *self.requested_graphics_api.borrow_mut() = opengl.clone();
+                set(opengl)
+            }
+            result => result,
+        }
     }
 
