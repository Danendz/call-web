{
  "name": "call-danya",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,speech,web \"npm:dev:server\" \"npm:dev:speech\" \"npm:dev:web\"",
    "dev:server": "NO_RATE_LIMITS=1 tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:speech": "tsx watch --env-file-if-exists=.env server/speechService.ts",
    "dev:web": "vite",
    "build": "vite build && tsx scripts/precompress.ts && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "build:speech": "tsc -p tsconfig.server.json",
    "start:speech": "node dist/server/speechService.js",
    "test": "node --import tsx --test server/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "fixtures": "tsx scripts/fixtures.ts",
    "invite": "tsx --env-file-if-exists=.env scripts/invite.ts",
    "denoise:wasm": "tsx scripts/denoise-wasm.ts"
  },
  "dependencies": {
    "postgres": "3.4.9",
    "sherpa-onnx-node": "2.0.1",
    "vaul": "1.1.2",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "lucide-react": "1.55.0",
    "railway": "^3.16.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "6.0.3"
  }
}
